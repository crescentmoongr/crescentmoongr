{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "MANGA_STORAGE",
      "bucket_name": "manga-storage"
    }
  ],
  "main": "./src/worker.js",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "DISCORD_WEBHOOK_URL",
      "TELEGRAM_BOT_TOKEN"
    ]
  },
  "vars": {
    "TELEGRAM_CHAT_ID": "-3911386685"
  }
}
