---
import '../styles/global.css';
import { getSessionUser } from '../lib/auth';
export const prerender=false;
const {
  title = 'Crescent Moon Translation',
  description = 'Crescent Moon Translation',
  image = '/social-preview.png',
  imageAlt,
  canonical,
  ogType = 'website'
} = Astro.props;

const pageUrl = new URL(canonical || Astro.url.pathname, Astro.url.origin).href;
const absoluteImage = new URL(image || '/social-preview.png', Astro.url.origin).href;
const user = await getSessionUser(Astro.cookies);
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={pageUrl} />

  <!-- Social preview: keep these server-rendered and near the top of HEAD -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Crescent Moon Translation" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:secure_url" content={absoluteImage} />
  <meta property="og:image:alt" content={imageAlt || title} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  <meta name="twitter:image:alt" content={imageAlt || title} />

  <meta itemprop="name" content={title} />
  <meta itemprop="description" content={description} />
  <meta itemprop="image" content={absoluteImage} />

  <link rel="icon" type="image/png" href="/honeymoon_4213586.png" />
  <link rel="shortcut icon" href="/honeymoon_4213586.png" />
</head>
<body>
<header class="site-header"><a class="brand" href="/"><img src="/crescent-moon-logo.png" alt="Crescent Moon" class="site-logo" /></a><nav><a href="/">Trang chủ</a><a href="/search">Tìm kiếm</a><a href="/password">Mật khẩu</a>{user?.role==='admin'&&<a href="/admin">Admin</a>}{user?<a href="/account">{user.display_name||user.username||'Tài khoản'}</a>:<a href="/login">Đăng nhập</a>}</nav></header>
<main class="shell"><slot /></main><footer class="footer">2024 Crescent Moon Translation</footer><script is:inline data-copy-protection>
(() => {
  const canEdit = (target) => {
    if (!(target instanceof Element)) return false;
    return !!target.closest('input, textarea, select, [contenteditable="true"], .rich-editor, .rich-editor-shell');
  };

  document.addEventListener('copy', (event) => {
    if (!canEdit(event.target)) event.preventDefault();
  });

  document.addEventListener('cut', (event) => {
    if (!canEdit(event.target)) event.preventDefault();
  });

  document.addEventListener('contextmenu', (event) => {
    if (!canEdit(event.target)) event.preventDefault();
  });

  document.addEventListener('dragstart', (event) => {
    if (!canEdit(event.target)) event.preventDefault();
  });

  document.addEventListener('keydown', (event) => {
    if (canEdit(event.target)) return;
    const key = String(event.key || '').toLowerCase();
    if ((event.ctrlKey || event.metaKey) && ['c','x','a','s','u'].includes(key)) {
      event.preventDefault();
    }
  });
})();
</script>
<script is:inline data-password-toggle>
(() => {
  const enhance = (input) => {
    if (!(input instanceof HTMLInputElement) || input.dataset.passwordToggleReady === '1') return;
    input.dataset.passwordToggleReady = '1';

    const wrap = document.createElement('div');
    wrap.className = 'password-toggle-wrap';
    input.parentNode?.insertBefore(wrap, input);
    wrap.appendChild(input);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'password-toggle-button';
    button.setAttribute('aria-label', 'Hiện mật khẩu');
    button.setAttribute('title', 'Hiện mật khẩu');
    button.innerHTML = `
      <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
        <circle cx="12" cy="12" r="2.7"></circle>
      </svg>
      <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 3l18 18"></path>
        <path d="M10.6 6.2A10.6 10.6 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-3 3.7"></path>
        <path d="M6.1 6.1C3.7 7.8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3.1-.5"></path>
      </svg>`;
    wrap.appendChild(button);

    button.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      wrap.classList.toggle('is-visible', show);
      const label = show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu';
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    });
  };

  const run = () => document.querySelectorAll('input[type="password"]').forEach(enhance);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
})();
</script>

<script is:inline data-chapter-notifications>
(() => {
  if (location.pathname.startsWith('/admin')) return;

  const CHECK_KEY='crescent_notif_check_at_v1';
  const SEEN_KEY='crescent_seen_chapters_v1';
  const now=Date.now();
  const last=Number(localStorage.getItem(CHECK_KEY)||0);
  if(now-last<5*60*1000) return;
  localStorage.setItem(CHECK_KEY,String(now));

  fetch('/api/notifications/latest',{credentials:'same-origin'})
    .then(r=>r.ok?r.json():null)
    .then(data=>{
      const items=Array.isArray(data?.items)?data.items:[];
      let seen=[];
      try{seen=JSON.parse(localStorage.getItem(SEEN_KEY)||'[]')}catch{}
      if(!Array.isArray(seen))seen=[];
      const item=items.find(x=>x&&x.id&&!seen.includes(x.id));
      if(!item)return;

      // Mark as seen as soon as it is shown, so it does not pop up on every page.
      seen.unshift(item.id);
      localStorage.setItem(SEEN_KEY,JSON.stringify(seen.slice(0,100)));

      const toast=document.createElement('aside');
      toast.className='site-notification-toast';
      toast.setAttribute('role','status');

      const close=document.createElement('button');
      close.type='button';
      close.className='site-notification-close';
      close.setAttribute('aria-label','Đóng thông báo');
      close.textContent='×';

      const icon=document.createElement('div');
      icon.className='site-notification-icon';
      icon.textContent='✨';

      const content=document.createElement('div');
      content.className='site-notification-content';

      const eyebrow=document.createElement('div');
      eyebrow.className='site-notification-eyebrow';
      eyebrow.textContent='Có chapter mới';

      const title=document.createElement('strong');
      title.textContent=String(item.title||'Truyện mới cập nhật');

      const chapter=document.createElement('span');
      chapter.textContent=`Chapter ${item.chapter_number}${item.chapter_title?' — '+item.chapter_title:''}`;

      const link=document.createElement('a');
      link.className='site-notification-link';
      link.href=String(item.href||'/');
      link.textContent='Đọc ngay →';

      content.append(eyebrow,title,chapter,link);
      toast.append(icon,content,close);
      document.body.appendChild(toast);

      requestAnimationFrame(()=>toast.classList.add('is-visible'));
      const dismiss=()=>{
        toast.classList.remove('is-visible');
        setTimeout(()=>toast.remove(),220);
      };
      close.addEventListener('click',dismiss);
      setTimeout(dismiss,12000);
    })
    .catch(()=>{});
})();
</script>

</body></html>
