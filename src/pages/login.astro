---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;

const token = Astro.cookies.get('cm_access_token')?.value;
if (token) return Astro.redirect('/admin');
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Đăng nhập Admin — Crescent Reader">
<section class="admin-card">
  <h1>Đăng nhập Admin</h1>
  <p class="description">Dùng tài khoản quản trị đã tạo trong Supabase.</p>
  {error && <div class="notice error">{error}</div>}
  <form method="POST" action="/api/auth/login">
    <label class="field">
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="field">
      <span>Mật khẩu</span>
      <input name="password" type="password" autocomplete="current-password" required />
    </label>
    <button class="button" type="submit">Đăng nhập</button>
  </form>
</section>
</BaseLayout>
