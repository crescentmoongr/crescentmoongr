---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagBySlug,getSeriesList,statusLabel } from '../../lib/supabase';
export const prerender=false;
const slug=Astro.params.slug||'';
const tag=await getTagBySlug(slug);
if(!tag)return new Response('Không tìm thấy Tag.',{status:404});
const all=await getSeriesList();
const rows=all.filter(x=>(x.tags||[]).some(g=>g.trim().toLowerCase()===tag.name.trim().toLowerCase()));
const badge=(s:string)=>({completed:'FULL',ongoing:'ONGOING',hiatus:'HIATUS',dropped:'DROP',upcoming:'UPCOMING'} as Record<string,string>)[s]||'';
const badgeClass=(s:string)=>({completed:'full',ongoing:'ongoing',hiatus:'hiatus',dropped:'drop',upcoming:'upcoming'} as Record<string,string>)[s]||'';
---
<BaseLayout title={`${tag.name} — Tag | Crescent Moon Translation`} description={`Các truyện thuộc Tag ${tag.name} tại Crescent Moon Translation.`}>
<section class="taxonomy-page-head"><div><div class="taxonomy-kicker">Tag</div><h1>{tag.name}</h1><p class="meta">{rows.length} truyện</p></div></section>
{rows.length?<section class="grid">{rows.map(item=><a class="card" href={`/manga/${item.slug}`}><div class="cover card-cover">{badge(item.status)&&<span class={`cover-badge ${badgeClass(item.status)}`}>{badge(item.status)}</span>}{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div><div class="card-body"><h3>{item.title}</h3><div class="meta">{item.type||'—'} · {statusLabel(item.status)}</div></div></a>)}</section>:<div class="empty-state">Chưa có truyện nào thuộc Tag này.</div>}
</BaseLayout>
