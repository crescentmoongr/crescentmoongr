---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeriesList, getAllPublicChapters, statusLabel, getMyHistory, getServiceSiteSetting } from '../lib/supabase';
import { getSession } from '../lib/auth';
import { richTextToHtml } from '../lib/richText';
export const prerender=false;
let allSeries:any[]=[]; let updated:any[]=[]; let allChapters:any[]=[]; let error='';
let latestChapter=new Map<string,number>();
try{
  const [seriesRows,chapterRows]=await Promise.all([getSeriesList(),getAllPublicChapters()]);
  allSeries=seriesRows;
  allChapters=chapterRows;
  const lastPublished=new Map<string,number>();
  for(const ch of allChapters){
    const when=new Date(ch.published_at||ch.created_at).getTime();
    if(!lastPublished.has(ch.series_id)||when>(lastPublished.get(ch.series_id)||0)) lastPublished.set(ch.series_id,when);
    const n=Number(ch.chapter_number); if(!latestChapter.has(ch.series_id)||n>(latestChapter.get(ch.series_id)||-Infinity)) latestChapter.set(ch.series_id,n);
  }
  updated=[...seriesRows].filter(x=>x.status!=='upcoming'&&lastPublished.has(x.id)).sort((a,b)=>(lastPublished.get(b.id)||0)-(lastPublished.get(a.id)||0));
}catch(e){error=e instanceof Error?e.message:'Không thể tải dữ liệu.'}
const recent=updated.slice(0,32);
const recentMore=updated.slice(32).map(item=>({
  id:item.id,
  slug:item.slug,
  title:item.title,
  cover_key:item.cover_key,
  status:item.status,
  latest_chapter:latestChapter.has(item.id)?latestChapter.get(item.id):null
}));
const upcomingSeries=[...allSeries].filter(x=>x.status==='upcoming').sort((a,b)=>new Date(b.updated_at||b.created_at||0).getTime()-new Date(a.updated_at||a.created_at||0).getTime()).slice(0,8);
const favoriteRanking=[...allSeries].filter(x=>Number(x.favorite_count||0)>0).sort((a,b)=>Number(b.favorite_count||0)-Number(a.favorite_count||0)).slice(0,10);
// v12.18: the homepage hero is discovery-focused: choose 5 random public series with covers on each page request.
const randomSlidePool=[...allSeries].filter(item=>Boolean(item.cover_key));
for(let i=randomSlidePool.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [randomSlidePool[i],randomSlidePool[j]]=[randomSlidePool[j],randomSlidePool[i]];
}
const favoriteSlides=randomSlidePool.slice(0,5);
const plainIntro=(value:any)=>String(value||'').replace(/<[^>]*>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&#39;/g,"'").replace(/\s+/g,' ').trim();
const session=await getSession(Astro.cookies);
let recentHistory:any[]=[];
if(session){
  try{
    const history=await getMyHistory(session.user.id,session.token);
    const seriesMap=new Map(allSeries.map(x=>[x.id,x]));
    const chapterMap=new Map(allChapters.map(ch=>[ch.id,ch]));
    recentHistory=history.slice(0,4).map(h=>{
      const item=seriesMap.get(h.series_id);
      const chapter=chapterMap.get(h.chapter_id);
      return item?{item,chapter,updated_at:h.updated_at}:null;
    }).filter(Boolean);
  }catch{}
}
const statusBadgeLabel=(status:string)=>({completed:'FULL',ongoing:'ONGOING',hiatus:'HIATUS',dropped:'DROP',upcoming:'UPCOMING'} as Record<string,string>)[status]||'';
const statusBadgeClass=(status:string)=>({completed:'full',ongoing:'ongoing',hiatus:'hiatus',dropped:'drop',upcoming:'upcoming'} as Record<string,string>)[status]||'';
let siteAnnouncementHtml='';
try{siteAnnouncementHtml=richTextToHtml((await getServiceSiteSetting('site_announcement_html'))?.value||'')}catch{}

---
<BaseLayout title="Crescent Moon Translation">

{session&&!String(session.user.username||'').trim()&&<div class="username-required-overlay" role="dialog" aria-modal="true" aria-labelledby="username-required-title">
  <div class="username-required-modal">
    <div class="username-required-icon" aria-hidden="true">@</div>
    <h2 id="username-required-title">Bổ sung Username</h2>
    <p>Tài khoản của bạn chưa có Username. Vui lòng bổ sung Username để tiếp tục sử dụng website và hiển thị đúng tên khi bình luận.</p>
    <a class="button username-required-action" href="/account?username_required=1#profile">Đi đến Account</a>
  </div>
</div>}


{siteAnnouncementHtml&&<section class="site-announcement home-site-announcement" aria-label="Thông báo chung">
  <div class="site-announcement-icon" aria-hidden="true"><img src="/announcement-icon.png" alt="" loading="eager" decoding="async"/></div>
  <div class="site-announcement-content rich-content" set:html={siteAnnouncementHtml}></div>
</section>}

{error?<div class="notice error">{error}</div>:<>

{favoriteSlides.length>0&&<section class="favorite-hero-slider" data-favorite-slider aria-label="Truyện ngẫu nhiên">
  <div class="favorite-hero-track">
    {favoriteSlides.map((item,index)=><a class={`favorite-hero-slide ${index===0?'is-active':''}`} href={`/manga/${item.slug}`} data-favorite-slide aria-hidden={index===0?'false':'true'}>
      {item.cover_key&&<div class="favorite-hero-bg" aria-hidden="true"><img src={`/api/cover/${item.id}`} alt="" loading={index===0?'eager':'lazy'} decoding="async"/></div>}
      <div class="favorite-hero-tint" aria-hidden="true"></div>
      <div class="favorite-hero-cover">{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading={index===0?'eager':'lazy'} decoding="async"/>:<span>{item.title}</span>}</div>
      <div class="favorite-hero-info">
        <h2>{item.title}</h2>
        {item.author&&<div class="favorite-hero-author"><span>Tác giả</span> {item.author}</div>}
        {item.description&&<p class="favorite-hero-intro">{plainIntro(item.description)}</p>}
      </div>
    </a>)}
  </div>
  {favoriteSlides.length>1&&<>
  <button type="button" class="favorite-hero-arrow favorite-hero-prev" data-favorite-prev aria-label="Truyện trước">‹</button>
  <button type="button" class="favorite-hero-arrow favorite-hero-next" data-favorite-next aria-label="Truyện tiếp theo">›</button>
  <div class="favorite-hero-dots" aria-label="Chọn slide">
    {favoriteSlides.map((item,index)=><button type="button" class={`favorite-hero-dot ${index===0?'is-active':''}`} data-favorite-dot data-index={index} aria-label={`Xem ${item.title}`} aria-current={index===0?'true':'false'}></button>)}
  </div></>}
</section>}

{recentHistory.length>0&&<>
<section class="history-continue-panel home-section-content">
  <div class="history-continue-head"><h2 class="home-section-title moon-heading"><img src="/half-moon.png" alt="" aria-hidden="true"/>Lịch sử đọc gần đây</h2></div>
  <div class="history-continue-grid">
  {recentHistory.map(({item,chapter})=>{
    const latest=Number(latestChapter.get(item.id)||chapter?.chapter_number||1);
    const current=Number(chapter?.chapter_number||0);
    const progress=Math.max(5,Math.min(100,latest>0?(current/latest)*100:5));
    return <a class="history-continue-card" href={chapter?`/read/${item.slug}/${chapter.chapter_number}`:`/manga/${item.slug}`}>
      <div class="history-continue-cover">{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div>
      <div class="history-continue-info"><h3>{item.title}</h3><div class="meta">{chapter?`Chapter ${chapter.chapter_number}`:'Đọc tiếp'}</div><div class="history-progress"><span style={`width:${progress}%`}></span></div></div>
    </a>
  })}
  </div>
</section>
</>}

{favoriteRanking.length>0&&<>
<div class="section-title home-section-head"><h2 class="home-section-title moon-heading"><img src="/half-moon.png" alt="" aria-hidden="true"/>Top yêu thích</h2></div>
<section class="favorite-rank-slider home-section-content" data-rank-slider>
  <button type="button" class="rank-slider-arrow rank-slider-prev" data-rank-prev aria-label="Xem hạng trước">‹</button>
  <div class="favorite-rank-track" data-rank-track>
  {favoriteRanking.map((item,index)=><a class={`favorite-rank-card rank-${index+1}`} href={`/manga/${item.slug}`}>
    <div class="favorite-rank-cover">{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}<div class="favorite-rank-shade"></div><div class="favorite-rank-copy"><h3>{item.title}</h3><div>♥ {Number(item.favorite_count||0)} yêu thích</div></div></div>
    <span class="favorite-rank-big">{index+1}</span>
  </a>)}
  </div>
  <button type="button" class="rank-slider-arrow rank-slider-next" data-rank-next aria-label="Xem hạng tiếp">›</button>
</section>
</>}

{upcomingSeries.length>0&&<>
<section class="upcoming-feature home-section-content" data-upcoming-slider aria-label="Sắp ra mắt">
  <div class="upcoming-feature-head"><h2 class="home-section-title moon-heading"><img src="/half-moon.png" alt="" aria-hidden="true"/>Sắp ra mắt</h2><div class="upcoming-feature-count"><span data-upcoming-current>01</span> / {String(upcomingSeries.length).padStart(2,'0')}</div></div>
  <div class="upcoming-feature-track">
    {upcomingSeries.map((item,index)=>{ const tags=[...(Array.isArray(item.genres)?item.genres:[]),item.type].filter(Boolean).slice(0,2); return <article class={`upcoming-feature-card ${index===0?'is-active':''}`} data-upcoming-card>
      <a class="upcoming-feature-cover" href={`/manga/${item.slug}`}><span class="cover-badge upcoming">UPCOMING</span>{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading={index===0?'eager':'lazy'}/>:<span>{item.title}</span>}</a>
      <div class="upcoming-feature-info"><h3><a href={`/manga/${item.slug}`}>{item.title}</a></h3>{tags.length>0&&<div class="upcoming-feature-tags">{tags.join(' · ')}</div>}<div class="upcoming-feature-wait">Chờ Trăng nha~ 🌙</div><a class="upcoming-feature-link" href={`/manga/${item.slug}`}>Xem giới thiệu <span aria-hidden="true">→</span></a></div>
    </article>})}
  </div>
</section>
</>}

<div class="section-title home-section-head"><h2 class="home-section-title moon-heading"><img src="/half-moon.png" alt="" aria-hidden="true"/>Mới cập nhật</h2></div>
{recent.length?<>
<section class="grid home-section-content" data-recent-grid>{recent.map(item=><a class="card" href={`/manga/${item.slug}`}><div class="cover card-cover">{statusBadgeLabel(item.status)&&<span class={`cover-badge ${statusBadgeClass(item.status)}`}>{statusBadgeLabel(item.status)}</span>}{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div><div class="card-body"><h3>{item.title}</h3><div class="meta">{latestChapter.has(item.id)?`Chap ${latestChapter.get(item.id)} · `:''}{statusLabel(item.status)}</div></div></a>)}</section>
{recentMore.length>0&&<div class="home-more-bottom"><button class="home-more-button" type="button" data-home-load-more>Xem thêm <span aria-hidden="true">↓</span></button></div>}
<script type="application/json" id="recent-more-data" set:html={JSON.stringify(recentMore).replace(/</g,'\\u003c')}></script>
</>:<div class="empty-state">Chưa có truyện.</div>}
</>}
<script>
  const sliders=document.querySelectorAll('[data-favorite-slider]');
  sliders.forEach((slider)=>{
    const slides=Array.from(slider.querySelectorAll('[data-favorite-slide]'));
    const dots=Array.from(slider.querySelectorAll('[data-favorite-dot]'));
    const prev=slider.querySelector('[data-favorite-prev]');
    const next=slider.querySelector('[data-favorite-next]');
    if(slides.length<2)return;
    let active=0;
    let timer;
    let touchStartX=0;
    const show=(next)=>{
      active=(next+slides.length)%slides.length;
      slides.forEach((slide,index)=>{
        const current=index===active;
        slide.classList.toggle('is-active',current);
        slide.setAttribute('aria-hidden',current?'false':'true');
      });
      dots.forEach((dot,index)=>{
        const current=index===active;
        dot.classList.toggle('is-active',current);
        dot.setAttribute('aria-current',current?'true':'false');
      });
    };
    const stop=()=>{if(timer)window.clearInterval(timer)};
    const start=()=>{stop();timer=window.setInterval(()=>show(active+1),5000)};
    dots.forEach((dot)=>dot.addEventListener('click',()=>{show(Number(dot.dataset.index||0));start()}));
    prev?.addEventListener('click',(event)=>{event.preventDefault();show(active-1);start()});
    next?.addEventListener('click',(event)=>{event.preventDefault();show(active+1);start()});
    slider.addEventListener('mouseenter',stop);
    slider.addEventListener('mouseleave',start);
    slider.addEventListener('focusin',stop);
    slider.addEventListener('focusout',start);
    slider.addEventListener('touchstart',(event)=>{touchStartX=event.touches[0]?.clientX||0;stop()},{passive:true});
    slider.addEventListener('touchend',(event)=>{
      const endX=event.changedTouches[0]?.clientX||0;
      const delta=endX-touchStartX;
      if(Math.abs(delta)>45)show(active+(delta<0?1:-1));
      start();
    },{passive:true});
    start();
  });

  document.querySelectorAll('[data-upcoming-slider]').forEach((slider)=>{
    const cards=Array.from(slider.querySelectorAll('[data-upcoming-card]'));
    const current=slider.querySelector('[data-upcoming-current]');
    const activate=(index)=>{cards.forEach((card,i)=>card.classList.toggle('is-active',i===index));if(current)current.textContent=String(index+1).padStart(2,'0');cards[index]?.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});};
    cards.forEach((card,index)=>card.addEventListener('click',(event)=>{if(card.classList.contains('is-active'))return;event.preventDefault();activate(index);}));
  });

  document.querySelectorAll('[data-rank-slider]').forEach((slider)=>{
    const track=slider.querySelector('[data-rank-track]');
    const prev=slider.querySelector('[data-rank-prev]');
    const next=slider.querySelector('[data-rank-next]');
    if(!track)return;
    const step=()=>Math.max(220,track.clientWidth*.82);
    prev?.addEventListener('click',()=>track.scrollBy({left:-step(),behavior:'smooth'}));
    next?.addEventListener('click',()=>track.scrollBy({left:step(),behavior:'smooth'}));
  });

  const loadMoreButton=document.querySelector('[data-home-load-more]');
  const recentGrid=document.querySelector('[data-recent-grid]');
  const recentDataNode=document.getElementById('recent-more-data');
  if(loadMoreButton&&recentGrid&&recentDataNode){
    let remaining=[];
    try{remaining=JSON.parse(recentDataNode.textContent||'[]')}catch{}
    let offset=0;
    const batchSize=32;
    const statusText={completed:'Hoàn thành',ongoing:'Đang tiến hành',hiatus:'Tạm ngưng',dropped:'Đã drop',upcoming:'Sắp ra mắt'};
    const badgeText={completed:'FULL',ongoing:'ONGOING',hiatus:'HIATUS',dropped:'DROP',upcoming:'UPCOMING'};
    const badgeClass={completed:'full',ongoing:'ongoing',hiatus:'hiatus',dropped:'drop',upcoming:'upcoming'};
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    loadMoreButton.addEventListener('click',()=>{
      const batch=remaining.slice(offset,offset+batchSize);
      if(!batch.length){loadMoreButton.closest('.home-more-bottom')?.remove();return}
      const fragment=document.createDocumentFragment();
      batch.forEach((item)=>{
        const link=document.createElement('a');
        link.className='card';
        link.href=`/manga/${encodeURIComponent(item.slug)}`;
        const badge=badgeText[item.status]?`<span class="cover-badge ${badgeClass[item.status]||''}">${badgeText[item.status]}</span>`:'';
        const cover=item.cover_key?`<img src="/api/cover/${encodeURIComponent(item.id)}" alt="Bìa ${esc(item.title)}" loading="lazy" decoding="async">`:`<span>${esc(item.title)}</span>`;
        const latest=item.latest_chapter!==null&&item.latest_chapter!==undefined?`Chap ${esc(item.latest_chapter)} · `:'';
        link.innerHTML=`<div class="cover card-cover">${badge}${cover}</div><div class="card-body"><h3>${esc(item.title)}</h3><div class="meta">${latest}${esc(statusText[item.status]||item.status||'')}</div></div>`;
        fragment.appendChild(link);
      });
      recentGrid.appendChild(fragment);
      offset+=batch.length;
      if(offset>=remaining.length)loadMoreButton.closest('.home-more-bottom')?.remove();
    });
  }
</script>
</BaseLayout>
