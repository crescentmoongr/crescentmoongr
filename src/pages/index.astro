---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeriesList, getChapters, statusLabel } from '../lib/supabase';

export const prerender = false;
let series = [];
let error = '';
let latestChapter = new Map<string, number>();
try {
  series = await getSeriesList();
  const chapterGroups = await Promise.all(series.map((item) => getChapters(item.id)));
  series.forEach((item, i) => {
    const first = chapterGroups[i]?.[0];
    if (first) latestChapter.set(item.id, first.chapter_number);
  });
} catch (e) {
  error = e instanceof Error ? e.message : 'Không thể tải dữ liệu.';
}
---
<BaseLayout title="Crescent Reader">
<section class="hero">
  <h1>Thư viện truyện</h1>
  <p>Dữ liệu truyện và chapter được đọc trực tiếp từ Supabase. Ảnh truyện sẽ lưu riêng trong Cloudflare R2.</p>
</section>

{error ? (
  <div class="notice error"><strong>Chưa kết nối được database.</strong><br />{error}</div>
) : (
  <>
    <div class="section-title"><h2>Truyện mới cập nhật</h2><span class="meta">{series.length} truyện</span></div>
    {series.length === 0 ? (
      <div class="empty-state"><h3>Database đang trống</h3><p>Hệ thống đã kết nối. Khi thêm truyện đầu tiên vào bảng <code>series</code>, truyện sẽ xuất hiện tại đây.</p></div>
    ) : (
      <section class="grid">
        {series.map((item) => (
          <a class="card" href={`/manga/${item.slug}`}>
            <div class="cover">{item.cover_key ? <img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy" /> : <span>{item.title}</span>}</div>
            <div class="card-body">
              <h3>{item.title}</h3>
              <div class="meta">{latestChapter.has(item.id) ? `Chap ${latestChapter.get(item.id)} · ` : ''}{statusLabel(item.status)}</div>
            </div>
          </a>
        ))}
      </section>
    )}
  </>
)}
</BaseLayout>
