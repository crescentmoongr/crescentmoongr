---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeriesList, getNewestSeries, getAllPublicChapters, statusLabel, getMyHistory } from '../lib/supabase';
import { getSession } from '../lib/auth';
export const prerender=false;
let updated=[]; let newest=[]; let allChapters:any[]=[]; let error='';
let latestChapter=new Map<string,number>();
try{
  const [seriesRows,newRows,chapterRows]=await Promise.all([getSeriesList(),getNewestSeries(),getAllPublicChapters()]);
  allChapters=chapterRows;
  newest=newRows;
  const lastPublished=new Map<string,number>();
  for(const ch of allChapters){
    const when=new Date(ch.published_at||ch.created_at).getTime();
    if(!lastPublished.has(ch.series_id)||when>(lastPublished.get(ch.series_id)||0)) lastPublished.set(ch.series_id,when);
    const n=Number(ch.chapter_number); if(!latestChapter.has(ch.series_id)||n>(latestChapter.get(ch.series_id)||-Infinity)) latestChapter.set(ch.series_id,n);
  }
  updated=[...seriesRows].sort((a,b)=>(lastPublished.get(b.id)||new Date(b.updated_at).getTime())-(lastPublished.get(a.id)||new Date(a.updated_at).getTime()));
}catch(e){error=e instanceof Error?e.message:'Không thể tải dữ liệu.'}
const manga=updated.filter(x=>String(x.type||'').toLowerCase()!=='novel').slice(0,12);
const novels=updated.filter(x=>String(x.type||'').toLowerCase()==='novel').slice(0,12);
const recent=updated.slice(0,8);
const session=await getSession(Astro.cookies);
let recentHistory:any[]=[];
if(session){
  try{
    const history=await getMyHistory(session.user.id,session.token);
    const seriesMap=new Map(updated.map(x=>[x.id,x]));
    const chapterMap=new Map(allChapters.map(ch=>[ch.id,ch]));
    recentHistory=history.slice(0,4).map(h=>{
      const item=seriesMap.get(h.series_id);
      const chapter=chapterMap.get(h.chapter_id);
      return item?{item,chapter,updated_at:h.updated_at}:null;
    }).filter(Boolean);
  }catch{}
}
const statusBadgeLabel=(status:string)=>({completed:'FULL',ongoing:'ONGOING',hiatus:'HIATUS',dropped:'DROP'} as Record<string,string>)[status]||'';
const statusBadgeClass=(status:string)=>({completed:'full',ongoing:'ongoing',hiatus:'hiatus',dropped:'drop'} as Record<string,string>)[status]||'';

---
<BaseLayout title="Crescent Moon Translation">

{error?<div class="notice error">{error}</div>:<>

{recentHistory.length>0&&<>
<div class="section-title home-section-head home-section-head-first"><h2 class="home-section-title">Lịch sử đọc gần đây</h2></div>
<section class="history-cover-grid home-section-content">
  {recentHistory.map(({item,chapter})=>
    <a class="history-cover-card" href={chapter?`/read/${item.slug}/${chapter.chapter_number}`:`/manga/${item.slug}`}>
      <div class="history-cover-image">
        {item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}
      </div>
      <div class="history-cover-body">
        <h3>{item.title}</h3>
        <div class="meta">{chapter?`Đang đọc Chapter ${chapter.chapter_number}`:'Đọc tiếp'}</div>
      </div>
    </a>
  )}
</section>
</>}

<div class="section-title home-section-head"><h2 class="home-section-title">Mới cập nhật</h2><a class="home-more-button" href="/search">Xem tất cả <span aria-hidden="true">→</span></a></div>{recent.length?<section class="grid home-section-content">{recent.map(item=><a class="card" href={`/manga/${item.slug}`}><div class="cover card-cover">{statusBadgeLabel(item.status)&&<span class={`cover-badge ${statusBadgeClass(item.status)}`}>{statusBadgeLabel(item.status)}</span>}{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div><div class="card-body"><h3>{item.title}</h3><div class="meta">{latestChapter.has(item.id)?`Chap ${latestChapter.get(item.id)} · `:''}{statusLabel(item.status)}</div></div></a>)}</section>:<div class="empty-state">Chưa có truyện.</div>}
<div class="section-title home-section-head"><h2 class="home-section-title">Manga / Manhwa / Manhua</h2><a class="home-more-button" href="/search">Xem tất cả <span aria-hidden="true">→</span></a></div>{manga.length?<section class="grid home-section-content">{manga.map(item=><a class="card" href={`/manga/${item.slug}`}><div class="cover card-cover">{statusBadgeLabel(item.status)&&<span class={`cover-badge ${statusBadgeClass(item.status)}`}>{statusBadgeLabel(item.status)}</span>}{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div><div class="card-body"><h3>{item.title}</h3><div class="meta">{item.type||'Manga'} · {statusLabel(item.status)}</div></div></a>)}</section>:<div class="empty-state">Chưa có truyện nhóm Manga.</div>}
<div class="section-title home-section-head"><h2 class="home-section-title">Novel</h2><a class="home-more-button" href="/search?type=Novel">Xem tất cả <span aria-hidden="true">→</span></a></div>{novels.length?<section class="grid home-section-content">{novels.map(item=><a class="card" href={`/manga/${item.slug}`}><div class="cover card-cover">{statusBadgeLabel(item.status)&&<span class={`cover-badge ${statusBadgeClass(item.status)}`}>{statusBadgeLabel(item.status)}</span>}{item.cover_key?<img src={`/api/cover/${item.id}`} alt={`Bìa ${item.title}`} loading="lazy"/>:<span>{item.title}</span>}</div><div class="card-body"><h3>{item.title}</h3><div class="meta">Novel · {statusLabel(item.status)}</div></div></a>)}</section>:<div class="empty-state">Chưa có Novel.</div>}
</>}
</BaseLayout>
