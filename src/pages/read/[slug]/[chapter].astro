---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { findManga } from '../../../data/manga';
const { slug, chapter } = Astro.params;
const manga = slug ? findManga(slug) : undefined;
const current = manga?.chapters.find((c)=>String(c.number)===chapter);
if (!manga || !current) return Astro.redirect('/');
---
<BaseLayout title={`Chapter ${current.number} — ${manga.title}`}>
<h1>{manga.title} — Chapter {current.number}</h1>
{current.locked ? (
<section class="lock-panel"><h2>🔒 Chapter này đang khóa</h2><p class="description">Giao diện demo. Khi nối Supabase/Worker, mật khẩu sẽ được kiểm tra phía server trước khi trả URL ảnh.</p><form onsubmit="event.preventDefault(); alert('Demo: chưa nối backend.');"><label class="field">Mật khẩu chapter<input type="password" placeholder="Nhập mật khẩu" /></label><button class="button" type="submit">Mở khóa</button></form></section>
) : (
<><div class="reader-nav"><a class="button secondary" href={`/manga/${manga.slug}`}>← Danh sách chap</a><span class="meta">Reader demo</span></div>{[1,2,3,4].map((page)=><div class="page-image">Trang ảnh {page}<br/>R2 sẽ được nối ở bước sau</div>)}<div class="reader-nav"><a class="button secondary" href={`/manga/${manga.slug}`}>← Mục lục</a><a class="button" href="#">Lên đầu trang ↑</a></div></>
)}
</BaseLayout>
