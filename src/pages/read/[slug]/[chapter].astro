// Mobile-only Canvas lifecycle: keep nearby pages, release off-screen backing stores.
// Source files, signed URLs and chapter-view counters are not changed.
const mobileCanvasMaxPages=5;
const mobileCanvasMaxPixels=24_000_000;
let mobileCleanupFrame=0;
const distanceFromViewport=(wrap)=>{
