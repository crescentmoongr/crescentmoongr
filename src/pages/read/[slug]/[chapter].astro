  let pixels=loaded.reduce((n,w)=>n+Number(w.dataset.canvasPixels||0),0)+Number(exclude?.dataset.canvasPixels||0);
  for(const wrap of candidates){
    if(count<=mobileCanvasMaxPages&&pixels<=mobileCanvasMaxPixels)break;
