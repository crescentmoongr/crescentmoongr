// Reader-only deterrents. Browser extensions can bypass client-side handlers.
const protectionNotice=document.getElementById('reader-protection-notice');
let protectionTimer;
const showProtectionNotice=()=>{
  if(!(protectionNotice instanceof HTMLElement))return;
  protectionNotice.classList.add('is-visible');
  protectionNotice.setAttribute('aria-hidden','false');
  window.clearTimeout(protectionTimer);
  protectionTimer=window.setTimeout(()=>{
    protectionNotice.classList.remove('is-visible');
    protectionNotice.setAttribute('aria-hidden','true');
  },3000);
};
if(protectionNotice){
  protectionNotice.addEventListener('click',()=>{
    protectionNotice.classList.remove('is-visible');
    protectionNotice.setAttribute('aria-hidden','true');
    window.clearTimeout(protectionTimer);
  });
  document.addEventListener('contextmenu',e=>{
    e.preventDefault();
    showProtectionNotice();
  },{capture:true});
  document.addEventListener('dragstart',e=>{
    if(e.target instanceof Element&&e.target.closest('[data-protected-reader]')){
      e.preventDefault();showProtectionNotice();
    }
  },{capture:true});
  document.addEventListener('keydown',e=>{
    const key=e.key.toLowerCase();
    const ctrl=e.ctrlKey||e.metaKey;
    const protectedKey=e.key==='F12'||(ctrl&&e.shiftKey&&['i','j','c'].includes(key))||(ctrl&&['u','s','p'].includes(key));
    const copyingReader=ctrl&&['c','x'].includes(key)&&(
      e.target instanceof Element&&!!e.target.closest('[data-protected-reader],.novel-reader-content') ||
      window.getSelection()?.anchorNode?.parentElement?.closest('.novel-reader-content')
    );
    if(protectedKey||copyingReader){
      e.preventDefault();e.stopPropagation();showProtectionNotice();
    }
  },{capture:true});
}
</script>

<script>
const reactionRoot=document.querySelector('[data-chapter-reactions]');
if(reactionRoot instanceof HTMLElement){
  const chapterId=reactionRoot.dataset.chapterId;
  const status=reactionRoot.querySelector('[data-reaction-status]');
  const buttons=[...reactionRoot.querySelectorAll('[data-reaction]')];
  const setStatus=(message)=>{if(status)status.textContent=message};
  const render=(data)=>{
    for(const button of buttons){
      const key=button.dataset.reaction;
      const count=button.querySelector('[data-count]');
      if(count)count.textContent=String(data.counts?.[key]||0);
      const selected=!!data.mine?.includes(key);
      button.classList.toggle('is-selected',selected);
      button.setAttribute('aria-pressed',String(selected));
    }
  };
  fetch('/api/chapter-reactions?chapter_id='+encodeURIComponent(chapterId||''),{credentials:'same-origin'})
    .then(async r=>{const data=await r.json();if(!r.ok)throw new Error(data.error||'Không tải được cảm xúc.');return data})
    .then(render).catch(e=>setStatus(e.message));
  buttons.forEach(button=>button.addEventListener('click',async()=>{
    if(reactionRoot.dataset.authenticated!=='1'){
      location.href='/login?next='+encodeURIComponent(location.pathname+location.search);return;
    }
    if(button.disabled)return;
    button.disabled=true;setStatus('');
    try{
      const response=await fetch('/api/chapter-reactions',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({chapter_id:chapterId,reaction:button.dataset.reaction})});
      const data=await response.json();if(!response.ok)throw new Error(data.error||'Không thể lưu cảm xúc.');render(data);
    }catch(e){setStatus(e instanceof Error?e.message:'Có lỗi xảy ra.');}
    finally{button.disabled=false;}
  }));
}
</script>
