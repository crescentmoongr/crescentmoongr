  }
};
// Serialize mobile image fetch + decode + Canvas draw to avoid Safari memory spikes.
// Desktop retains the existing parallel loading behavior.
const mobileQueue=[];
let mobileQueueBusy=false;
const processMobileQueue=async()=>{
  if(mobileQueueBusy)return;
