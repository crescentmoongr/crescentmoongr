---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getChapters,getSeriesBySlug,statusLabel,getBookmark,getReadingHistory,getChapterReads,getSeriesComments } from '../../lib/supabase';
import { getSession } from '../../lib/auth';
import { richTextToHtml } from '../../lib/richText';
export const prerender=false;
const {slug}=Astro.params; if(!slug) return Astro.redirect('/');
let series=null; let chapters=[]; let error='';
try{series=await getSeriesBySlug(slug); if(series) chapters=await getChapters(series.id)}catch(e){error=e instanceof Error?e.message:'Không thể tải dữ liệu.'}
if(!series&&!error) return new Response('Không tìm thấy truyện.',{status:404});
const session=series?await getSession(Astro.cookies):null;
let bookmarked=false, history=null, readIds=new Set<string>();
if(series&&session){
  const [b,h,r]=await Promise.all([getBookmark(series.id,session.user.id,session.token),getReadingHistory(series.id,session.user.id,session.token),getChapterReads(series.id,session.user.id,session.token)]);
  bookmarked=!!b; history=h; readIds=new Set(r.map(x=>x.chapter_id));
}
const continueChapter=history?chapters.find(c=>c.id===history.chapter_id):null;
const latest=chapters[0]||null;
const updated=latest?.published_at||series?.updated_at;
const accessText=series?.access_type==='password'?'🔒 Khóa mật khẩu cả bộ':series?.access_type==='member'?'🔒 Dành cho thành viên':'Public';
const fmt=(v?:string|null)=>v?new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date(v)):'—';
const introHtml=series?richTextToHtml(series.description):'';
let comments:any[]=[];
if(series){try{comments=await getSeriesComments(series.id)}catch{}}
const commentError=Astro.url.searchParams.get('comment_error');
const commentSuccess=Astro.url.searchParams.get('comment')==='success';
---
<BaseLayout title={series?`${series.title} | Crescent Moon Translation`:'Lỗi | Crescent Moon Translation'} description={series?.description?String(series.description).replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim().slice(0,180):'Đọc truyện tại Crescent Moon Translation.'} image={series?.cover_key?`/api/og-cover/${series.id}`:"/social-preview.png"} imageAlt={series?`Bìa truyện ${series.title}`:"Crescent Moon Translation"} ogType="article">
{error?<div class="notice error">{error}</div>:series?<>
<section class="manga-head">
  <div class="manga-cover-wrap">
    <div class="cover manga-detail-cover">
      {series.cover_key?<img src={`/api/cover/${series.id}`} alt={`Bìa ${series.title}`}/>:<span>{series.title}</span>}
    </div>
  </div>

  <div class="manga-info">
    <h1>{series.title}</h1>

    <div class="series-info-list">
      <div class="series-info-row"><span class="series-info-icon">▣</span><span><b>Loại:</b> {series.type||'—'}</span></div>
      <div class="series-info-row"><span class="series-info-icon">♡</span><span><b>Trạng thái:</b> {statusLabel(series.status)}</span></div>
      <div class="series-info-row"><span class="series-info-icon">▤</span><span><b>Số chapter:</b> {chapters.length}</span></div>
      <div class="series-info-row"><span class="series-info-icon">☆</span><span><b>Chapter mới:</b> {latest?`Chapter ${latest.chapter_number}`:'—'}</span></div>
      <div class="series-info-row"><span class="series-info-icon">▦</span><span><b>Cập nhật:</b> {fmt(updated)}</span></div>
      <div class="series-info-row"><span class="series-info-icon">♙</span><span><b>Quyền đọc:</b> {accessText}</span></div>
      <div class="series-info-row"><span class="series-info-icon">✎</span><span><b>Tác giả:</b> {series.author||'Chưa cập nhật'}</span></div>
      <div class="series-info-row"><span class="series-info-icon">✎</span><span><b>Họa sĩ:</b> {series.artist||'Chưa cập nhật'}</span></div>
    </div>

    {series.genres?.length?<div class="pills">{series.genres.map(g=><span class="pill">{g}</span>)}</div>:null}

    <div class="row-actions manga-actions">
      <form method="POST" action="/api/library/bookmark">
        <input type="hidden" name="series_id" value={series.id}/>
        <input type="hidden" name="return_to" value={`/manga/${series.slug}`}/>
        <button class="button secondary" type="submit">{bookmarked?'★ Đã bookmark':'☆ Bookmark'}</button>
      </form>
      {continueChapter
        ? <a class="button" href={`/read/${series.slug}/${continueChapter.chapter_number}`}>Đọc tiếp Chapter {continueChapter.chapter_number}</a>
        : latest
          ? <a class="button" href={`/read/${series.slug}/${chapters[chapters.length-1].chapter_number}`}>Bắt đầu đọc</a>
          : null}
    </div>
  </div>
</section>

<section class="intro-section">
  <div class="section-title intro-title"><h2>Giới thiệu</h2></div>
  {introHtml
    ? <div class="rich-content" set:html={introHtml}></div>
    : <div class="empty-intro">Chưa có giới thiệu.</div>}
</section>

<div class="section-title"><h2>Danh sách chương</h2><span class="meta">{chapters.length} chap</span></div>
{chapters.length===0?<div class="empty-state">Chưa có chapter được đăng.</div>:<div class="chapter-list">{chapters.map(ch=><a class={`chapter ${readIds.has(ch.id)?'chapter-read':''}`} href={`/read/${series.slug}/${ch.chapter_number}`}><span>Chapter {ch.chapter_number}{ch.title?` — ${ch.title}`:''}</span><span class="chapter-right">{session&&<span class={readIds.has(ch.id)?'read-state read':'read-state'}>{readIds.has(ch.id)?'✓ Đã đọc':'Chưa đọc'}</span>}<span class={series.access_type==='public'?'meta':'lock'}>{series.access_type==='password'?'🔒':series.access_type==='member'?'🔒':'Đọc'}</span></span></a>)}</div>}

<section class="comments-section" id="comments">
  <div class="section-title"><h2>Bình luận</h2><span class="meta">{comments.length} bình luận</span></div>
  {commentSuccess&&<div class="notice success">Đã gửi bình luận.</div>}
  {commentError&&<div class="notice error">{commentError}</div>}

  {session
    ? <form method="POST" action="/api/comments/create" class="comment-form">
        <input type="hidden" name="series_id" value={series.id}/>
        <input type="hidden" name="return_to" value={`/manga/${series.slug}`}/>
        <label class="field"><span>Bình luận với tư cách <strong>{session.user.display_name||session.user.username||'Thành viên'}</strong></span><textarea name="body" rows="4" maxlength="2000" required placeholder="Viết bình luận..."></textarea></label>
        <div class="comment-form-footer"><span class="meta">Chỉ thành viên đã đăng nhập mới có thể bình luận.</span><button class="button" type="submit">Gửi bình luận</button></div>
      </form>
    : <div class="comment-login-note">💬 <a href={`/login?next=${encodeURIComponent(`/manga/${series.slug}#comments`)}`}>Đăng nhập</a> để tham gia bình luận.</div>}

  {comments.length===0
    ? <div class="empty-state comments-empty">Chưa có bình luận nào.</div>
    : <div class="comment-list">
        {comments.map(c=><article class="comment-item">
          <div class="comment-head">
            <div><strong>{c.display_name||c.username||'Thành viên'}</strong><span class="meta"> · {new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(c.created_at))}</span></div>
            {session&&(session.user.id===c.user_id||session.user.role==='admin')&&
              <form method="POST" action="/api/comments/delete" onsubmit="return confirm('Xóa bình luận này?');">
                <input type="hidden" name="id" value={c.id}/>
                <input type="hidden" name="return_to" value={`/manga/${series.slug}`}/>
                <button class="comment-delete" type="submit">Xóa</button>
              </form>}
          </div>
          <p>{c.body}</p>
        </article>)}
      </div>}
</section>
</>:null}
</BaseLayout>
