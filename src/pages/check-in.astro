---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession } from '../lib/auth';
import { getMyMemberRewards,getMyCheckinHistory } from '../lib/supabase';
export const prerender=false;
const session=await getSession(Astro.cookies); if(!session)return Astro.redirect('/login?next=/check-in');
const rewards=await getMyMemberRewards(session.token); const history=await getMyCheckinHistory(session.token,400).catch(()=>[]);
const checked=new Set(history.map(x=>x.checkin_date));
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const rankMap:any={none:['','Chưa xếp hạng'],mam_trang:['🌱','Mầm Trăng'],trang_non:['🌙','Trăng Non'],trang_tron:['🌕','Trăng Tròn'],anh_sao:['✨','Ánh Sao'],sao_sang:['🌟','Sao Sáng'],tinh_nguyet:['💫','Tinh Nguyệt']};
const [rankIcon,rankName]=rankMap[rewards?.rank_key||'none']||rankMap.none;
const milestones=[{n:1,icon:'🌱',name:'Mầm Trăng',gift:''},{n:7,icon:'🌙',name:'Trăng Non',gift:''},{n:30,icon:'🌕',name:'Trăng Tròn',gift:''},{n:60,icon:'✨',name:'Ánh Sao',gift:'Mở khóa màu tên tự chọn'},{n:100,icon:'🌟',name:'Sao Sáng',gift:''},{n:365,icon:'💫',name:'Tinh Nguyệt',gift:'Mở khóa màu tên tự chọn'}];
const vnParts=(date:Date)=>{const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit',weekday:'short'}).formatToParts(date);const g=(t:string)=>parts.find(x=>x.type===t)?.value||'';return {key:`${g('year')}-${g('month')}-${g('day')}`,label:`${g('day')}/${g('month')}`,weekday:g('weekday')}};
const now=new Date(); const wd=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Ho_Chi_Minh',weekday:'short'}).format(now); const idx=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].indexOf(wd); const monday=new Date(now.getTime()-Math.max(0,idx)*86400000); const calendarDays=Array.from({length:28},(_,i)=>vnParts(new Date(monday.getTime()+(i-14)*86400000)));
const success=Astro.url.searchParams.get('success'),error=Astro.url.searchParams.get('error');
---
<BaseLayout title="Điểm danh — Crescent Moon">
<section class="checkin-page-head admin-card"><div><h1>🌙 Điểm danh hằng ngày</h1><p>Tính theo ngày Việt Nam · 00:00–23:59 (Asia/Ho_Chi_Minh)</p></div><div class="checkin-stats"><span>🔥 Streak <strong>{rewards?.current_streak||0}</strong></span><span>🏆 Cao nhất <strong>{rewards?.highest_streak||0}</strong></span><span>{rankIcon} <strong>{rankName}</strong></span></div></section>
{success&&<div class="notice success">{success}</div>}{error&&<div class="notice error">{error}</div>}
<section class="checkin-journey admin-card"><div class="section-title"><div><h2>Lịch điểm danh</h2><p class="meta">Tuần bắt đầu từ Thứ 2 · ngày hiển thị theo giờ Việt Nam.</p></div></div><div class="checkin-journey-scroll"><div class="checkin-calendar-grid">{calendarDays.map((d,i)=><div class:list={['checkin-day-node',checked.has(d.key)&&'is-done',d.key===today&&'is-current',i<14&&'calendar-older']}><div class="checkin-day-circle">{checked.has(d.key)?'✓':d.label.split('/')[0]}</div><small>{d.weekday} · {d.label}{d.key===today?' · Hôm nay':''}</small></div>)}</div></div>
<form method="POST" action="/api/account/checkin" class="checkin-action"><input type="hidden" name="return_to" value="/check-in"/><button class="button" type="submit" disabled={rewards?.last_checkin_date===today}>{rewards?.last_checkin_date===today?'✓ Hôm nay đã điểm danh':'Điểm danh hôm nay'}</button></form></section>
<section class="admin-card checkin-rewards"><div class="section-title"><div><h2>🌙 Hạng thành viên</h2><p class="meta">Điểm danh hằng ngày để nâng hạng nha các tình yêu. Sẽ có phần quà cho hạng Ánh Sao và Tinh Nguyệt nha.</p></div><a class="button secondary small-button" href="/account">Tới Tài khoản</a></div><div class="checkin-reward-list">{milestones.map(m=><div class:list={['checkin-reward-item',(rewards?.highest_streak||0)>=m.n&&'is-unlocked']}><span class="checkin-reward-icon">{m.icon}</span><div><strong>{m.n} ngày · {m.name}</strong>{m.gift&&<p>{m.gift}</p>}</div><span class="checkin-reward-state">{(rewards?.highest_streak||0)>=m.n?'Đã nhận':'Chưa đạt'}</span></div>)}</div></section>
</BaseLayout>
