---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession } from '../lib/auth';
import { getMyMemberRewards,getMyCheckinHistory,getMyAchievementProgress } from '../lib/supabase';
export const prerender=false;
const session=await getSession(Astro.cookies);
const rewards=session?await getMyMemberRewards(session.token):null; const history=session?await getMyCheckinHistory(session.token,400).catch(()=>[]):[]; const achievementProgress=session?await getMyAchievementProgress(session.token).catch(()=>null):null;
const checked=new Set(history.map(x=>x.checkin_date));
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const rankMap:any={none:['','Chưa xếp hạng'],mam_trang:['🌱','Mầm Trăng'],trang_non:['🌙','Trăng Non'],trang_tron:['🌕','Trăng Tròn'],anh_sao:['✨','Ánh Sao'],sao_sang:['🌟','Sao Sáng'],tinh_nguyet:['💫','Tinh Nguyệt']};
const [rankIcon,rankName]=rankMap[rewards?.rank_key||'none']||rankMap.none;
const milestones=[{n:1,icon:'🌱',name:'Mầm Trăng',gift:''},{n:7,icon:'🌙',name:'Trăng Non',gift:''},{n:30,icon:'🌕',name:'Trăng Tròn',gift:''},{n:60,icon:'✨',name:'Ánh Sao',gift:'Mở khóa màu tên tự chọn'},{n:100,icon:'🌟',name:'Sao Sáng',gift:''},{n:365,icon:'💫',name:'Tinh Nguyệt',gift:'Mở khóa màu tên tự chọn'}];
const todayParts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
const part=(t:string)=>todayParts.find(x=>x.type===t)?.value||'';
const currentYear=Number(part('year')); const currentMonth=Number(part('month'));
const requested=Astro.url.searchParams.get('month')||''; const match=requested.match(/^(\d{4})-(\d{2})$/);
let viewYear=match?Number(match[1]):currentYear; let viewMonth=match?Number(match[2]):currentMonth;
if(viewMonth<1||viewMonth>12){viewYear=currentYear;viewMonth=currentMonth}
const firstUtc=new Date(Date.UTC(viewYear,viewMonth-1,1)); const daysInMonth=new Date(Date.UTC(viewYear,viewMonth,0)).getUTCDate();
const mondayIndex=(firstUtc.getUTCDay()+6)%7;
const calendarCells=Array.from({length:mondayIndex+daysInMonth},(_,i)=>{if(i<mondayIndex)return null;const day=i-mondayIndex+1;const mm=String(viewMonth).padStart(2,'0');const dd=String(day).padStart(2,'0');return {day,key:`${viewYear}-${mm}-${dd}`}});
while(calendarCells.length%7)calendarCells.push(null);
const prevDate=new Date(Date.UTC(viewYear,viewMonth-2,1)); const nextDate=new Date(Date.UTC(viewYear,viewMonth,1));
const prevMonth=`${prevDate.getUTCFullYear()}-${String(prevDate.getUTCMonth()+1).padStart(2,'0')}`; const nextMonth=`${nextDate.getUTCFullYear()}-${String(nextDate.getUTCMonth()+1).padStart(2,'0')}`;
const monthTitle=`Tháng ${String(viewMonth).padStart(2,'0')}/${viewYear}`;
const success=Astro.url.searchParams.get('success'),error=Astro.url.searchParams.get('error');
---
<BaseLayout title="Điểm danh — Crescent Moon">
<section class="checkin-page-head admin-card"><div><h1>🌙 Điểm danh hằng ngày</h1><p>Tính theo ngày Việt Nam · 00:00–23:59 (Asia/Ho_Chi_Minh)</p></div><div class="checkin-stats"><span>🔥 Streak <strong>{rewards?.current_streak||0}</strong></span><span>🏆 Cao nhất <strong>{rewards?.highest_streak||0}</strong></span><span>{rankIcon} <strong>{rankName}</strong></span></div></section>
{success&&<div class="notice success">{success}</div>}{error&&<div class="notice error">{error}</div>}
<section class="checkin-journey admin-card"><div class="section-title"><div><h2>Lịch điểm danh</h2><p class="meta">Theo tháng · tuần bắt đầu từ Thứ 2 · giờ Việt Nam.</p></div></div><div class="checkin-month-nav"><a class="button secondary small-button" href={`/check-in?month=${prevMonth}`}>‹ Tháng trước</a><strong>{monthTitle}</strong><a class="button secondary small-button" href={`/check-in?month=${nextMonth}`}>Tháng sau ›</a></div><div class="checkin-weekdays"><span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span></div><div class="checkin-month-grid">{calendarCells.map((d)=><div class:list={['checkin-month-cell',!d&&'is-empty',d&&checked.has(d.key)&&'is-done',d?.key===today&&'is-current',d&&d.key>today&&'is-future']}>{d&&<><div class="checkin-day-circle">{checked.has(d.key)?<img class="checkin-heart-icon" src="/checkin-heart.png" alt="Đã điểm danh"/>:d.day}</div>{d.key===today&&<small>Hôm nay</small>}</>}</div>)}</div>
{session?<form method="POST" action="/api/account/checkin" class="checkin-action"><input type="hidden" name="return_to" value="/check-in"/><button class="button" type="submit" disabled={rewards?.last_checkin_date===today}>{rewards?.last_checkin_date===today?'✓ Hôm nay đã điểm danh':'Điểm danh hôm nay'}</button></form>:<div class="checkin-action checkin-login-prompt"><p>Đăng nhập để điểm danh nè ♡</p><a class="button" href="/login?next=%2Fcheck-in">Đăng nhập →</a></div>}</section>
<section class="admin-card checkin-rewards"><div class="section-title"><div><h2>🌙 Hạng thành viên</h2><p class="meta">Điểm danh hằng ngày để nâng hạng nha các tình yêu. Sẽ có phần quà cho hạng Ánh Sao và Tinh Nguyệt nha.</p></div><a class="button secondary small-button" href={session?'/account':'/login?next=%2Fcheck-in'}>{session?'Tới Tài khoản':'Đăng nhập'}</a></div><div class="checkin-reward-list">{milestones.map(m=><div class:list={['checkin-reward-item',(rewards?.highest_streak||0)>=m.n&&'is-unlocked']}><span class="checkin-reward-icon">{m.icon}</span><div><strong>{m.n} ngày · {m.name}</strong>{m.gift&&<p>{m.gift}</p>}</div><span class="checkin-reward-state">{(rewards?.highest_streak||0)>=m.n?'Đã nhận':'Chưa đạt'}</span></div>)}</div></section>

<section class="admin-card checkin-achievements"><div class="section-title"><div><h2>🏅 Danh hiệu</h2><p class="meta">Hoàn thành các thử thách để mở khóa Danh hiệu nha. Danh hiệu đã mở khóa có thể chọn hiển thị cạnh tên trong Tài khoản.</p></div><a class="button secondary small-button" href={session?'/account':'/login?next=%2Fcheck-in'}>{session?'Tới Tài khoản':'Đăng nhập'}</a></div><div class="achievement-guide-list">
{[
 {name:'Mọt Truyện',icon:'📖',desc:'Đọc 10 chapter',value:achievementProgress?.read_count||0,target:10,unit:'chapter'},
 {name:'Nghiện Truyện',icon:'📚',desc:'Đọc 100 chapter',value:achievementProgress?.read_count||0,target:100,unit:'chapter'},
 {name:'Cú Đêm',icon:'🦉',desc:'Đọc truyện từ 00:00–04:00 theo giờ địa phương trong 14 đêm khác nhau',value:achievementProgress?.night_count||0,target:14,unit:'đêm'},
 {name:'Hóng Chap',icon:'👀',desc:'Đọc 20 chapter mới trong vòng 24 giờ kể từ khi đăng',value:achievementProgress?.fast_count||0,target:20,unit:'chapter'},
 {name:'Thánh Bình Luận',icon:'💬',desc:'Có bình luận trong 30 ngày khác nhau',value:achievementProgress?.comment_day_count||0,target:30,unit:'ngày'}
].map(a=>{const unlocked=Boolean(rewards?.achievements?.includes(a.name));const shown=Math.min(Number(a.value),a.target);return <div class:list={['achievement-guide-item',unlocked&&'is-unlocked']}><span class="achievement-guide-icon">{a.icon}</span><div class="achievement-guide-copy"><strong>{a.name}</strong><p>{a.desc}</p>{session&&!unlocked&&<div class="achievement-progress"><span style={`width:${Math.min(100,(shown/a.target)*100)}%`}></span></div>}</div><span class="achievement-guide-state">{!session?'Đăng nhập để xem tiến độ':unlocked?'✓ Đã mở khóa':`${shown}/${a.target} ${a.unit}`}</span></div>})}
<div class:list={['achievement-guide-item',Boolean(rewards?.achievements?.includes('Fan Cứng'))&&'is-unlocked']}><span class="achievement-guide-icon">❤️</span><div class="achievement-guide-copy"><strong>Fan Cứng</strong><p>Theo dõi 10 truyện + đọc 200 chapter</p>{session&&!rewards?.achievements?.includes('Fan Cứng')&&<div class="achievement-progress"><span style={`width:${Math.min(100,Math.min(((achievementProgress?.bookmark_count||0)/10)*100,((achievementProgress?.read_count||0)/200)*100))}%`}></span></div>}</div><span class="achievement-guide-state">{!session?'Đăng nhập để xem tiến độ':rewards?.achievements?.includes('Fan Cứng')?'✓ Đã mở khóa':`${Math.min(Number(achievementProgress?.bookmark_count||0),10)}/10 truyện · ${Math.min(Number(achievementProgress?.read_count||0),200)}/200 chapter`}</span></div>
</div></section>
</BaseLayout>
