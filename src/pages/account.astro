---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession } from '../lib/auth';
import { getMyBookmarks,getSeriesById,getMyMemberRewards } from '../lib/supabase';
export const prerender=false;
const session=await getSession(Astro.cookies); if(!session) return Astro.redirect('/login?next=/account');
const user=session.user; const success=Astro.url.searchParams.get('success'); const error=Astro.url.searchParams.get('error');
const usernameRequired=!String(user.username||'').trim() || Astro.url.searchParams.get('username_required')==='1';
const bookmarkRows=await getMyBookmarks(user.id,session.token);
const rewards=await getMyMemberRewards(session.token);
const rankMap:any={none:['','Chưa xếp hạng'],mam_trang:['🌱','Mầm Trăng'],trang_non:['🌙','Trăng Non'],trang_tron:['🌕','Trăng Tròn'],anh_sao:['✨','Ánh Sao'],sao_sang:['🌟','Sao Sáng'],tinh_nguyet:['💫','Tinh Nguyệt']};
const [rankIcon,rankName]=rankMap[rewards?.rank_key||'none']||rankMap.none;
const bookmarks=(await Promise.all(bookmarkRows.map(async b=>({b,series:await getSeriesById(b.series_id)})))).filter(x=>x.series);
---
<BaseLayout title="Tài khoản — Crescent Reader">
<section class="account-grid account-page-grid">
  <div class="admin-card account-card"><div class="account-top-row"><div class="account-head"><div class="avatar-box">{user.avatar_key?<img src={`/api/avatar/${user.id}?v=${Date.now()}`} alt="Avatar"/>:<span>☾</span>}</div><div><div class="account-member-identity"><span class="member-rank-icon">{user.role==='admin'?'👑':rankIcon}</span><h1 class:list={[user.role==='admin'?'admin-name-glow':'',user.role==='admin'?'admin-celestial-gold':'',rewards?.name_style?`member-name-${rewards.name_style}`:'']}>{user.display_name||user.username||'Tài khoản'}</h1>{rewards?.active_achievement&&<span class="comment-achievement-badge">{rewards.active_achievement}</span>}</div><div class="meta">{user.email}</div><span class="pill">{user.role==='admin'?'Admin':'Member'}</span></div></div><form method="POST" action="/api/auth/logout" class="account-logout-form"><button class="button secondary" type="submit">Đăng xuất</button></form></div>{success&&<div class="notice success top-gap">{success}</div>}{error&&<div class="notice error top-gap">{error}</div>}<form method="POST" action="/api/account/avatar" enctype="multipart/form-data"><label class="field"><span>Avatar</span><input name="avatar" type="file" accept="image/jpeg,image/png,image/webp" required/><small class="meta">JPG, PNG hoặc WebP · tối đa 2 MB.</small></label><button class="button secondary" type="submit">Đổi avatar</button></form></div>
  <div class="admin-card account-card" id="profile"><h2>Hồ sơ</h2>{usernameRequired&&<div class="notice warning username-account-notice"><strong>Vui lòng bổ sung Username.</strong><br/>Username chỉ được đặt một lần. Hãy chọn kỹ nha ♡</div>}<form method="POST" action="/api/account/profile"><label class="field"><span>Tên hiển thị</span><input name="display_name" maxlength="80" value={user.display_name||''}/></label><label class="field"><span>Username *</span><input name="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9_.-]+" autocomplete="username" value={user.username||''} required readonly={!usernameRequired} data-username-input data-username-locked={!usernameRequired?'1':'0'}/>{usernameRequired?<><small class="meta">3–40 ký tự · chữ cái, số, dấu chấm, gạch dưới hoặc gạch ngang.</small><small class="meta username-availability" data-username-status>Username chỉ được đặt một lần và không thể tự thay đổi sau khi lưu.</small></>:<small class="meta">🔒 Username đã được khóa. Nếu cần đổi, vui lòng liên hệ Admin.</small>}</label><button class="button" type="submit">Lưu hồ sơ</button></form></div>
  <div class="admin-card account-card"><h2>Đổi mật khẩu</h2><form method="POST" action="/api/account/password"><label class="field"><span>Mật khẩu mới</span><input name="password" type="password" minlength="8" autocomplete="new-password" required/></label><label class="field"><span>Nhập lại mật khẩu mới</span><input name="confirm_password" type="password" minlength="8" autocomplete="new-password" required/></label><button class="button" type="submit">Đổi mật khẩu</button></form></div>
</section>
<section class="admin-card admin-wide account-page-wide member-customize-panel">
  <div class="section-title"><div><h2>🏅 Danh hiệu của tôi</h2><p class="meta">Chọn Danh hiệu đã mở khóa để hiển thị cạnh tên khi bình luận.</p></div><a class="button secondary small-button" href="/check-in">Xem điểm danh</a></div>
  <form method="POST" action="/api/account/member-identity" class="member-identity-form" data-admin-preview={user.role==='admin'?'1':'0'}>
    <label class="field"><span>Danh hiệu đang sử dụng</span><select name="achievement"><option value="">Không hiển thị</option>{(rewards?.achievements||[]).map(x=><option value={x} selected={rewards?.active_achievement===x}>{x}</option>)}</select>{!(rewards?.achievements||[]).length&&<small class="meta">Chưa mở khóa Danh hiệu nào.</small>}</label>
    <label class="field"><span>🎨 Màu tên</span><select name="name_style" disabled={!rewards?.solid_color_unlocked}><option value="">Mặc định</option>{rewards?.solid_color_unlocked&&<><option value="pink" selected={rewards?.name_style==='pink'}>Hồng</option><option value="purple" selected={rewards?.name_style==='purple'}>Tím</option><option value="blue" selected={rewards?.name_style==='blue'}>Xanh lam</option><option value="cyan" selected={rewards?.name_style==='cyan'}>Cyan</option><option value="green" selected={rewards?.name_style==='green'}>Xanh lá</option><option value="orange" selected={rewards?.name_style==='orange'}>Cam</option><option value="red" selected={rewards?.name_style==='red'}>Đỏ</option><option value="mocha" selected={rewards?.name_style==='mocha'}>Mocha</option></>}{rewards?.premium_color_unlocked&&<><option value="sakura" selected={rewards?.name_style==='sakura'}>Sakura Dream ✨</option><option value="moonlight" selected={rewards?.name_style==='moonlight'}>Moonlight ✨</option><option value="galaxy" selected={rewards?.name_style==='galaxy'}>Galaxy ✨</option><option value="crystal" selected={rewards?.name_style==='crystal'}>Crystal ✨</option><option value="aurora" selected={rewards?.name_style==='aurora'}>Aurora ✨</option><option value="sunset" selected={rewards?.name_style==='sunset'}>Sunset ✨</option><option value="crimson" selected={rewards?.name_style==='crimson'}>Crimson Flame ✨</option><option value="cotton" selected={rewards?.name_style==='cotton'}>Cotton Candy ✨</option><option value="purple_haze" selected={rewards?.name_style==='purple_haze'}>Purple Haze ✨</option><option value="starlight" selected={rewards?.name_style==='starlight'}>Starlight ✨</option><option value="prismatic" selected={rewards?.name_style==='prismatic'}>Prismatic ✨</option></>}</select><small class="meta">{rewards?.premium_color_unlocked?'Đã mở Gradient + Glow 365 ngày.':rewards?.solid_color_unlocked?'Màu thường đã mở. Gradient + Glow mở ở 365 ngày.':'Mở khóa khi đạt streak 60 ngày.'}</small></label>
    <div class="member-identity-preview" data-member-preview>
      <span class="meta member-preview-label">Xem trước</span>
      <div class="member-preview-line">
        <span class="member-rank-icon">{user.role==='admin'?'👑':rankIcon}</span>
        <strong data-member-preview-name class:list={[user.role==='admin'?'admin-celestial-gold':'',rewards?.name_style?`member-name-${rewards.name_style}`:'']}>{user.display_name||user.username||'Thành viên'}</strong>
        <span class="comment-achievement-badge" data-member-preview-achievement hidden={!rewards?.active_achievement}>{rewards?.active_achievement||''}</span>
      </div>
    </div>
    <button class="button" type="submit">Lưu thay đổi</button>
  </form>
</section>
<section class="admin-card admin-wide account-bookmark-section account-page-wide">
  <div class="section-title"><h2>★ Truyện đã bookmark</h2><span class="meta">{bookmarks.length} truyện</span></div>
  {bookmarks.length?
    <div class="account-bookmark-grid">
      {bookmarks.map(({series})=>
        <a class="account-bookmark-card" href={`/manga/${series!.slug}`}>
          <div class="account-bookmark-cover">
            {series!.cover_key?<img src={`/api/cover/${series!.id}`} alt={`Bìa ${series!.title}`} loading="lazy"/>:<span>{series!.title}</span>}
          </div>
          <div class="account-bookmark-body">
            <h3>{series!.title}</h3>
          </div>
        </a>
      )}
    </div>
    :<div class="empty-state">Chưa bookmark truyện nào.</div>}
</section>
</BaseLayout>

<script>
const usernameInput=document.querySelector('[data-username-input]');
const usernameStatus=document.querySelector('[data-username-status]');
if(usernameInput instanceof HTMLInputElement && usernameStatus instanceof HTMLElement && usernameInput.dataset.usernameLocked!=='1'){
  usernameInput.addEventListener('blur',async()=>{
    const username=usernameInput.value.trim().toLowerCase();
    if(username.length<3){usernameStatus.textContent='Username cần ít nhất 3 ký tự.';return;}
    usernameStatus.textContent='Đang kiểm tra username...';
    try{const r=await fetch('/api/account/username-availability?username='+encodeURIComponent(username));const data=await r.json();usernameStatus.textContent=data.available?'✓ Username này có thể sử dụng':'Username này đã có người sử dụng rồi, chọn tên khác nha ♡';usernameStatus.classList.toggle('is-available',!!data.available);usernameStatus.classList.toggle('is-taken',!data.available);}catch{usernameStatus.textContent='Sẽ kiểm tra lại username khi cậu bấm Lưu hồ sơ.';}
  });
}

const identityForm=document.querySelector('.member-identity-form');
if(identityForm instanceof HTMLFormElement){
  const styleSelect=identityForm.querySelector('select[name="name_style"]');
  const achievementSelect=identityForm.querySelector('select[name="achievement"]');
  const previewName=identityForm.querySelector('[data-member-preview-name]');
  const previewAchievement=identityForm.querySelector('[data-member-preview-achievement]');
  const styleClasses=['pink','purple','blue','cyan','green','orange','red','mocha','sakura','moonlight','galaxy','crystal','aurora','sunset','crimson','cotton','purple_haze','starlight','prismatic'].map(x=>'member-name-'+x);
  const updatePreview=()=>{
    if(previewName instanceof HTMLElement && styleSelect instanceof HTMLSelectElement){
      previewName.classList.remove(...styleClasses);
      if(styleSelect.value)previewName.classList.add('member-name-'+styleSelect.value);
      // Admin may preview any selected style; Celestial Gold is the saved/default admin identity.
      previewName.classList.toggle('admin-celestial-gold', identityForm.dataset.adminPreview==='1' && !styleSelect.value);
    }
    if(previewAchievement instanceof HTMLElement && achievementSelect instanceof HTMLSelectElement){
      previewAchievement.textContent=achievementSelect.value;
      previewAchievement.hidden=!achievementSelect.value;
    }
  };
  styleSelect?.addEventListener('change',updatePreview);
  achievementSelect?.addEventListener('change',updatePreview);
  updatePreview();
}
</script>
