---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAdminSeriesById,getAdminChapters,hasAdminSeriesPassword,getChapterStats,chapterAdminStatus,getAuthors,getGenres } from '../../../lib/supabase';
import { requireAdminSession } from '../../../lib/auth';
import { richTextToHtml,novelRichTextToHtml } from '../../../lib/richText';
export const prerender=false;
const adminSession=await requireAdminSession(Astro.cookies);if(!adminSession)return Astro.redirect('/login?next=/admin');const token=adminSession.token;const id=Astro.params.id||'';const series=await getAdminSeriesById(id,token);if(!series)return new Response('Không tìm thấy truyện.',{status:404});const chapters=await getAdminChapters(id,token);const chapterStats=await getChapterStats(chapters.map(c=>c.id),token);const statMap=new Map(chapterStats.map(x=>[x.chapter_id,Number(x.view_count||0)]));const totalViews=chapterStats.reduce((n,x)=>n+Number(x.view_count||0),0);const hasPassword=series.access_type==='password'?await hasAdminSeriesPassword(id,token):false;const success=Astro.url.searchParams.get('success');const error=Astro.url.searchParams.get('error');const descriptionHtml=richTextToHtml(series.description);const isNovel=String(series.type||'').toLowerCase()==='novel';const [authors,genresManaged]=await Promise.all([getAuthors(),getGenres()]);
---
<BaseLayout title={`Quản lý — ${series.title}`}>
<section class="admin-card admin-wide"><div class="admin-top"><div><a class="meta" href="/admin">← Admin</a><h1>{series.title}</h1><p class="meta">{chapters.length} chapter · {totalViews.toLocaleString('vi-VN')} lượt đọc</p></div></div>{success&&<div class="notice success">{success}</div>}{error&&<div class="notice error">{error}</div>}
<div class="section-title"><h2>Sửa truyện</h2></div><form method="POST" action="/api/admin/series/update" enctype="multipart/form-data" class="admin-form"><input type="hidden" name="id" value={series.id}/><div class="form-grid"><label class="field"><span>Tên truyện *</span><input name="title" value={series.title} required maxlength="200"/></label><label class="field"><span>Slug *</span><input name="slug" value={series.slug} required maxlength="200"/></label><label class="field"><span>Tác giả</span><input name="author" maxlength="500" value={series.author||''} list="author-suggestions" placeholder="Ví dụ: Kasukabe Akira, Hanabusa Suuji"/><datalist id="author-suggestions">{authors.map(a=><option value={a.name}/>)}</datalist><small class="meta">Có nhiều tác giả thì ngăn cách bằng dấu phẩy. Mỗi tên sẽ tự tạo thành một tác giả riêng với slug riêng.</small></label><div class="field genre-picker-field">
  <span>Thể loại</span>
  <div class="genre-bubble-picker" data-genre-picker>
    {genresManaged.map(g=>
      <label class="genre-bubble">
        <input type="checkbox" name="genres" value={g.name} checked={(series.genres||[]).includes(g.name)}/>
        <span>{g.name}</span>
      </label>
    )}
  </div>
  <small class="meta">Bấm vào từng thể loại để chọn hoặc bỏ chọn.</small>
</div><label class="field"><span>Link mua raw</span><input name="raw_url" type="url" maxlength="1000" value={series.raw_url||''} placeholder="https://..."/><small class="meta">Link trang chính thức để người đọc mua raw và ủng hộ tác giả.</small></label><label class="field"><span>Loại truyện</span><select name="type"><option value="">— Chưa chọn —</option>{['Manga','Manhwa','Manhua','Novel','Other'].map(x=><option value={x} selected={series.type===x}>{x}</option>)}</select></label><label class="field"><span>Trạng thái</span><select name="status"><option value="ongoing" selected={series.status==='ongoing'}>Đang tiến hành</option><option value="completed" selected={series.status==='completed'}>Hoàn thành</option><option value="hiatus" selected={series.status==='hiatus'}>Tạm ngưng</option><option value="dropped" selected={series.status==='dropped'}>Drop</option></select></label><label class="field"><span>Quyền đọc *</span><select name="access_type" id="series_access_type"><option value="public" selected={series.access_type==='public'}>Public</option><option value="password" selected={series.access_type==='password'}>Khóa mật khẩu cả bộ</option><option value="member" selected={series.access_type==='member'}>Thành viên</option></select></label><label class="field" id="series_password_field" hidden><span>{hasPassword?'Đổi mật khẩu truyện':'Mật khẩu truyện *'}</span><input name="series_password" type="password" minlength="4" autocomplete="new-password" placeholder={hasPassword?'Để trống để giữ mật khẩu cũ':''}/></label></div>
<div class="field rich-field">
  <span>Giới thiệu</span>
  <div class="comment-editor-shell admin-comment-editor-shell " data-admin-rich-editor>
  <div class="comment-toolbar" role="toolbar" aria-label="Định dạng văn bản">
    <button type="button" data-admin-comment-cmd="bold" title="In đậm"><strong>B</strong></button>
    <button type="button" data-admin-comment-cmd="italic" title="In nghiêng"><em>I</em></button>
    <button type="button" data-admin-comment-cmd="underline" title="Gạch chân"><u>U</u></button>
    <button type="button" data-admin-comment-cmd="strikeThrough" title="Gạch ngang"><s>S</s></button>
    <button type="button" data-admin-comment-action="upper" title="IN HOA">AA</button>
    <button type="button" data-admin-comment-cmd="insertUnorderedList" title="Danh sách chấm">• List</button>
    <button type="button" data-admin-comment-cmd="insertOrderedList" title="Danh sách số">1. List</button>
    <button type="button" data-admin-comment-block="blockquote" title="Trích dẫn">❞</button>
    <button type="button" data-admin-comment-block="code" title="Code">&lt;/&gt;</button>
    <button type="button" data-admin-comment-action="clear" title="Xóa định dạng">Tx</button>
  </div>
  <div class="comment-editor admin-comment-editor" contenteditable="true" data-placeholder="Nhập phần giới thiệu..." spellcheck="true" set:html={descriptionHtml}></div>
  <textarea class="comment-source admin-comment-source" name="description" maxlength="20000" hidden></textarea>
</div>
  <small class="meta">Dùng cùng kiểu soạn thảo với phần Bình luận để tránh lỗi định dạng.</small>
</div>
<label class="field"><span>Thay ảnh bìa</span><input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif"/></label><label class="check-row"><input name="is_published" type="checkbox" value="true" checked={series.is_published}/><span>Đăng công khai</span></label><div class="row-actions"><button class="button" type="submit">Lưu thay đổi</button>{series.is_published&&<a class="button secondary" href={`/manga/${series.slug}`}>Xem trang truyện</a>}</div></form><hr class="soft-rule"/><form method="POST" action="/api/admin/series/delete" onsubmit="return confirm('Xóa truyện này và toàn bộ chapter/ảnh? Hành động này không thể hoàn tác.');"><input type="hidden" name="id" value={series.id}/><button class="danger-button" type="submit">Xóa truyện</button></form></section>

<section class="admin-card admin-wide"><div class="section-title"><h2>Thêm chapter</h2><span class="meta">{isNovel?'Soạn nội dung Novel':'Upload ảnh'} · publish ngay hoặc hẹn giờ</span></div><form method="POST" action="/api/admin/chapter/create" enctype="multipart/form-data" class="admin-form schedule-form"><input type="hidden" name="series_id" value={series.id}/><div class="form-grid"><label class="field"><span>Số chapter *</span><input name="chapter_number" type="number" step="0.01" min="0" required placeholder="1"/></label><label class="field"><span>Tiêu đề chapter</span><input name="title" maxlength="200"/></label><label class="field"><span>Trạng thái đăng</span><select name="publish_mode" class="publish-mode"><option value="publish">Publish ngay</option><option value="schedule">Lên lịch</option><option value="draft">Draft</option></select></label><label class="field schedule-field" hidden><span>Ngày giờ publish</span><input type="datetime-local" class="publish-local"/><input type="hidden" name="published_at" class="publish-iso"/><small class="meta">Dùng giờ trên máy của cậu.</small></label></div>
{isNovel?<div class="field rich-field novel-editor-field"><span>Nội dung chapter *</span><div class="comment-editor-shell admin-comment-editor-shell novel-comment-editor-shell" data-admin-rich-editor>
  <div class="comment-toolbar" role="toolbar" aria-label="Định dạng văn bản">
    <button type="button" data-admin-comment-cmd="bold" title="In đậm"><strong>B</strong></button>
    <button type="button" data-admin-comment-cmd="italic" title="In nghiêng"><em>I</em></button>
    <button type="button" data-admin-comment-cmd="underline" title="Gạch chân"><u>U</u></button>
    <button type="button" data-admin-comment-cmd="strikeThrough" title="Gạch ngang"><s>S</s></button>
    <button type="button" data-admin-comment-action="upper" title="IN HOA">AA</button>
    <button type="button" data-admin-comment-cmd="insertUnorderedList" title="Danh sách chấm">• List</button>
    <button type="button" data-admin-comment-cmd="insertOrderedList" title="Danh sách số">1. List</button>
    <button type="button" data-admin-comment-block="blockquote" title="Trích dẫn">❞</button>
    <button type="button" data-admin-comment-block="code" title="Code">&lt;/&gt;</button>
    <button type="button" data-admin-comment-action="clear" title="Xóa định dạng">Tx</button>
  </div>
  <div class="comment-editor admin-comment-editor" contenteditable="true" data-placeholder="Dán hoặc nhập nội dung chapter Novel vào đây..." spellcheck="true"></div>
  <textarea class="comment-source admin-comment-source" name="content_html" maxlength="500000" hidden></textarea>
</div><small class="meta">Có thể copy nội dung từ Word/Google Docs rồi chỉnh lại định dạng tại đây.</small></label>:<label class="field"><span>Ảnh chapter *</span><input name="pages" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple required/><small class="meta">Sắp theo tên file: 001.webp, 002.webp...</small></label>}
<button class="button" type="submit">{isNovel?'Tạo chapter Novel':'Tạo chapter & Upload ảnh'}</button></form></section>

<section class="admin-card admin-wide"><div class="section-title"><div><h2>Chapters</h2><p class="meta">Kéo thả để đổi thứ tự hiển thị. Preview dùng được cả Draft và chapter đã lên lịch.</p></div><span class="meta">{chapters.length} chapter</span></div>
<form id="bulkForm" method="POST" action="/api/admin/chapter/bulk" class="bulk-bar"><input type="hidden" name="series_id" value={series.id}/><select name="bulk_action" required><option value="">Sửa hàng loạt...</option><option value="publish">Publish ngay</option><option value="draft">Chuyển Draft</option><option value="delete">Xóa</option></select><button class="button secondary small-button" type="submit" data-bulk-submit>Áp dụng</button><button class="button secondary small-button" type="button" id="saveOrder">Lưu thứ tự kéo thả</button><span class="meta" id="orderStatus"></span></form>
{chapters.length===0?<div class="empty-state">Chưa có chapter nào.</div>:<div class="chapter-admin-list sortable-list" id="chapterSortable">{chapters.map(ch=>{const st=chapterAdminStatus(ch);return <details class="chapter-admin-item sortable-item" data-chapter-id={ch.id} draggable="true"><summary><span class="drag-handle" title="Kéo để đổi thứ tự">☰</span><input class="bulk-check" type="checkbox" name="chapter_ids" value={ch.id} form="bulkForm" onclick="event.stopPropagation()"/><strong>Chapter {ch.chapter_number}</strong>{ch.title&&<span> — {ch.title}</span>}<span class={`status-chip ${st==='Draft'?'draft':st==='Đã lên lịch'?'scheduled':'published'}`}>{st}</span><span class="meta"> · {(statMap.get(ch.id)||0).toLocaleString('vi-VN')} lượt đọc</span></summary>
<form method="POST" action="/api/admin/chapter/update" class="chapter-edit-form schedule-form"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><div class="form-grid"><label class="field"><span>Số chap</span><input name="chapter_number" type="number" step="0.01" value={ch.chapter_number} required/></label><label class="field"><span>Tiêu đề</span><input name="title" value={ch.title||''}/></label><label class="field"><span>Trạng thái đăng</span><select name="publish_mode" class="publish-mode"><option value="publish" selected={st==='Published'}>Published</option><option value="schedule" selected={st==='Đã lên lịch'}>Lên lịch</option><option value="draft" selected={st==='Draft'}>Draft</option></select></label><label class="field schedule-field" hidden><span>Ngày giờ publish</span><input type="datetime-local" class="publish-local" data-iso={ch.published_at||''}/><input type="hidden" name="published_at" class="publish-iso" value={ch.published_at||''}/></label></div>{isNovel&&<label class="field rich-field novel-editor-field"><span>Nội dung chapter</span><div class="comment-editor-shell admin-comment-editor-shell novel-comment-editor-shell" data-admin-rich-editor>
  <div class="comment-toolbar" role="toolbar" aria-label="Định dạng văn bản">
    <button type="button" data-admin-comment-cmd="bold" title="In đậm"><strong>B</strong></button>
    <button type="button" data-admin-comment-cmd="italic" title="In nghiêng"><em>I</em></button>
    <button type="button" data-admin-comment-cmd="underline" title="Gạch chân"><u>U</u></button>
    <button type="button" data-admin-comment-cmd="strikeThrough" title="Gạch ngang"><s>S</s></button>
    <button type="button" data-admin-comment-action="upper" title="IN HOA">AA</button>
    <button type="button" data-admin-comment-cmd="insertUnorderedList" title="Danh sách chấm">• List</button>
    <button type="button" data-admin-comment-cmd="insertOrderedList" title="Danh sách số">1. List</button>
    <button type="button" data-admin-comment-block="blockquote" title="Trích dẫn">❞</button>
    <button type="button" data-admin-comment-block="code" title="Code">&lt;/&gt;</button>
    <button type="button" data-admin-comment-action="clear" title="Xóa định dạng">Tx</button>
  </div>
  <div class="comment-editor admin-comment-editor" contenteditable="true" data-placeholder="Dán hoặc nhập nội dung chapter Novel vào đây..." spellcheck="true" set:html={novelRichTextToHtml(ch.content_html)}></div>
  <textarea class="comment-source admin-comment-source" name="content_html" maxlength="500000" hidden></textarea>
</div></div>}<div class="row-actions"><button class="button secondary" type="submit">Lưu chapter</button><a class="button secondary" href={`/admin/preview/${ch.id}`}>Preview</a>{st==='Published'&&<a class="button secondary" href={`/read/${series.slug}/${ch.chapter_number}`}>Xem public</a>}</div></form>
<div class="chapter-extra-actions"><form method="POST" action="/api/admin/chapter/duplicate" class="duplicate-form"><input type="hidden" name="source_id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><input name="target_number" type="number" step="0.01" required placeholder="Số chap copy"/><button class="button secondary small-button" type="submit">Duplicate</button></form><form method="POST" action="/api/admin/chapter/delete" onsubmit="return confirm('Xóa chapter này và toàn bộ ảnh?');"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><button class="danger-button small-danger" type="submit">Xóa chapter</button></form></div></details>})}</div>}
</section>
<script>
const a=document.querySelector('#series_access_type'),f=document.querySelector('#series_password_field');function toggleSeries(){if(a instanceof HTMLSelectElement&&f instanceof HTMLElement)f.hidden=a.value!=='password'}a?.addEventListener('change',toggleSeries);toggleSeries();
function localValue(iso){if(!iso)return'';const d=new Date(iso);if(!Number.isFinite(d.getTime()))return'';const z=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}T${z(d.getHours())}:${z(d.getMinutes())}`}
for(const form of document.querySelectorAll('.schedule-form')){if(!(form instanceof HTMLFormElement))continue;const mode=form.querySelector('.publish-mode'),field=form.querySelector('.schedule-field'),local=form.querySelector('.publish-local'),hidden=form.querySelector('.publish-iso');if(local instanceof HTMLInputElement&&local.dataset.iso)local.value=localValue(local.dataset.iso);const sync=()=>{if(mode instanceof HTMLSelectElement&&field instanceof HTMLElement)field.hidden=mode.value!=='schedule'};mode?.addEventListener('change',sync);sync();form.addEventListener('submit',e=>{if(mode instanceof HTMLSelectElement&&mode.value==='schedule'&&local instanceof HTMLInputElement&&hidden instanceof HTMLInputElement){if(!local.value){e.preventDefault();alert('Chọn ngày giờ publish.');return}hidden.value=new Date(local.value).toISOString()}})}
const list=document.querySelector('#chapterSortable');let dragging=null;if(list instanceof HTMLElement){for(const item of list.querySelectorAll('.sortable-item')){item.addEventListener('dragstart',()=>{dragging=item;item.classList.add('dragging')});item.addEventListener('dragend',()=>{item.classList.remove('dragging');dragging=null})}list.addEventListener('dragover',e=>{e.preventDefault();if(!(dragging instanceof HTMLElement))return;const after=[...list.querySelectorAll('.sortable-item:not(.dragging)')].find(el=>{const r=el.getBoundingClientRect();return e.clientY<r.top+r.height/2});if(after)list.insertBefore(dragging,after);else list.appendChild(dragging)})}
document.querySelector('#saveOrder')?.addEventListener('click',async()=>{if(!(list instanceof HTMLElement))return;const ids=[...list.querySelectorAll('.sortable-item')].map(x=>x.getAttribute('data-chapter-id')).filter(Boolean);const st=document.querySelector('#orderStatus');if(st)st.textContent='Đang lưu...';const sidInput=document.querySelector('#bulkForm input[name=series_id]');const sidValue=sidInput instanceof HTMLInputElement?sidInput.value:'';const r=await fetch('/api/admin/chapter/reorder',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({series_id:sidValue,ids})});if(st)st.textContent=r.ok?'Đã lưu thứ tự ✓':'Lưu thất bại';});
document.querySelector('[data-bulk-submit]')?.addEventListener('click',e=>{const select=document.querySelector('#bulkForm select');if(select instanceof HTMLSelectElement&&select.value==='delete'&&!confirm('Xóa tất cả chapter đã chọn và ảnh của chúng?'))e.preventDefault()});
</script>
<script>
function setupRichEditors(){
  document.querySelectorAll('.rich-editor-shell').forEach(shell=>{
    if(!(shell instanceof HTMLElement) || shell.dataset.ready==='1') return;
    shell.dataset.ready='1';
    const editor=shell.querySelector('.rich-editor');
    const source=shell.querySelector('.rich-source');
    if(!(editor instanceof HTMLElement)||!(source instanceof HTMLTextAreaElement)) return;
    const sync=()=>{source.value=editor.innerHTML.trim()};
    let savedRange=null;
    const saveSelection=()=>{
      const sel=window.getSelection();
      if(!sel||sel.rangeCount===0)return;
      const range=sel.getRangeAt(0);
      if(editor.contains(range.commonAncestorContainer))savedRange=range.cloneRange();
    };
    const restoreSelection=()=>{
      editor.focus();
      if(!savedRange)return;
      const sel=window.getSelection();
      if(!sel)return;
      sel.removeAllRanges();
      sel.addRange(savedRange);
    };

    editor.addEventListener('mouseup',saveSelection);
    editor.addEventListener('keyup',saveSelection);
    editor.addEventListener('focus',saveSelection);
    shell.querySelectorAll('.rich-tool').forEach(btn=>{
      btn.addEventListener('mousedown',e=>{
        e.preventDefault();
        saveSelection();
      });
    });

    shell.querySelectorAll('[data-rich-cmd]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const cmd=btn.getAttribute('data-rich-cmd')||'';
      const sel=window.getSelection();
      const hadSelection=!!(sel && sel.rangeCount && !sel.isCollapsed);

      // Formatting buttons only affect selected text.
      // If there is no selection, do nothing so Bold/Italic/Underline
      // can never become a sticky typing state.
      if(!hadSelection && ['bold','italic','underline'].includes(cmd)){
        return;
      }

      document.execCommand(cmd,false);

      // After formatting selected text, collapse the caret to the end
      // and explicitly neutralize any sticky inline formatting state.
      if(sel && sel.rangeCount && !sel.isCollapsed && ['bold','italic','underline'].includes(cmd)){
        const r=sel.getRangeAt(0).cloneRange();
        r.collapse(false);
        sel.removeAllRanges();
        sel.addRange(r);

        try{
          if(cmd==='bold' && document.queryCommandState('bold')) document.execCommand('bold',false);
          if(cmd==='italic' && document.queryCommandState('italic')) document.execCommand('italic',false);
          if(cmd==='underline' && document.queryCommandState('underline')) document.execCommand('underline',false);
        }catch{}
      }

      savedRange=sel&&sel.rangeCount?sel.getRangeAt(0).cloneRange():null;
      sync();
    }));
    shell.querySelectorAll('[data-rich-block]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const block=btn.getAttribute('data-rich-block')||'p';
      document.execCommand('formatBlock',false,block);
      saveSelection();
      sync();
    }));
    shell.querySelectorAll('[data-rich-action]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const action=btn.getAttribute('data-rich-action');
      if(action==='break') document.execCommand('insertHTML',false,'<br>');
      if(action==='rule') document.execCommand('insertHTML',false,'<hr><p><br></p>');
      if(action==='clear') document.execCommand('removeFormat',false);
      saveSelection();
      sync();
    }));
    editor.addEventListener('paste',e=>{
      e.preventDefault();
      const text=e.clipboardData?.getData('text/plain')||'';
      const sel=window.getSelection();
      if(!sel||sel.rangeCount===0)return;

      const range=sel.getRangeAt(0);
      range.deleteContents();

      // Always paste into a neutral wrapper. This prevents pasted text
      // from inheriting <strong>/<b> from the current caret container.
      const wrapper=document.createElement('span');
      wrapper.className='rich-paste-plain';

      const lines=text.replace(/\r\n?/g,'\n').split('\n');
      lines.forEach((line,index)=>{
        if(index)wrapper.appendChild(document.createElement('br'));
        wrapper.appendChild(document.createTextNode(line));
      });

      range.insertNode(wrapper);

      const next=document.createRange();
      next.setStartAfter(wrapper);
      next.collapse(true);
      sel.removeAllRanges();
      sel.addRange(next);
      savedRange=next.cloneRange();
      sync();
    });
    editor.addEventListener('input',sync);
    editor.addEventListener('blur',sync);
    editor.closest('form')?.addEventListener('submit',sync);
    sync();
  });
}
setupRichEditors();
</script>


<script>
function setupAdminCommentEditors(){
  document.querySelectorAll('[data-admin-rich-editor]').forEach(shell=>{
    if(!(shell instanceof HTMLElement) || shell.dataset.ready==='1') return;
    shell.dataset.ready='1';

    const editor=shell.querySelector('.admin-comment-editor');
    const source=shell.querySelector('.admin-comment-source');
    if(!(editor instanceof HTMLElement) || !(source instanceof HTMLTextAreaElement)) return;

    const normalizeHtml=()=>{
      const clone=editor.cloneNode(true);
      if(!(clone instanceof HTMLElement)) return editor.innerHTML.trim();

      // Chrome contenteditable commonly creates DIV blocks when Enter is pressed.
      // Normalize those blocks to paragraphs before submit so line/paragraph spacing survives sanitizing.
      clone.querySelectorAll('div').forEach(div=>{
        const p=document.createElement('p');
        while(div.firstChild) p.appendChild(div.firstChild);
        div.replaceWith(p);
      });
      return clone.innerHTML.trim();
    };

    const sync=()=>{ source.value=normalizeHtml(); };

    const getSelectedRange=()=>{
      const sel=window.getSelection();
      if(!sel || !sel.rangeCount || sel.isCollapsed) return null;
      const range=sel.getRangeAt(0);
      if(!editor.contains(range.commonAncestorContainer)) return null;
      return range;
    };

    const wrapSelection=(tag)=>{
      const range=getSelectedRange();
      if(!range) return;
      const node=document.createElement(tag);
      try{
        range.surroundContents(node);
      }catch{
        const frag=range.extractContents();
        node.appendChild(frag);
        range.insertNode(node);
      }
      const sel=window.getSelection();
      sel?.removeAllRanges();
      sync();
    };

    shell.querySelectorAll('[data-admin-comment-cmd]').forEach(btn=>{
      btn.addEventListener('mousedown',e=>e.preventDefault());
      btn.addEventListener('click',()=>{
        const cmd=btn.getAttribute('data-admin-comment-cmd')||'';

        // Inline formatting is selection-only. Clicking B/I/U/S with no selected text
        // does absolutely nothing, so formatting can never become sticky.
        if(cmd==='bold') return wrapSelection('strong');
        if(cmd==='italic') return wrapSelection('em');
        if(cmd==='underline') return wrapSelection('u');
        if(cmd==='strikeThrough') return wrapSelection('s');

        // Lists still use browser block commands, but only with an active selection/caret in editor.
        editor.focus();
        document.execCommand(cmd,false);
        sync();
      });
    });

    shell.querySelectorAll('[data-admin-comment-block]').forEach(btn=>{
      btn.addEventListener('mousedown',e=>e.preventDefault());
      btn.addEventListener('click',()=>{
        const block=btn.getAttribute('data-admin-comment-block')||'p';
        const range=getSelectedRange();
        if(!range) return;
        if(block==='code') wrapSelection('code');
        else{
          const node=document.createElement(block);
          try{
            range.surroundContents(node);
          }catch{
            const frag=range.extractContents();
            node.appendChild(frag);
            range.insertNode(node);
          }
          window.getSelection()?.removeAllRanges();
          sync();
        }
      });
    });

    shell.querySelectorAll('[data-admin-comment-action]').forEach(btn=>{
      btn.addEventListener('mousedown',e=>e.preventDefault());
      btn.addEventListener('click',()=>{
        const action=btn.getAttribute('data-admin-comment-action');
        const range=getSelectedRange();
        if(!range) return;

        if(action==='upper'){
          const text=range.toString();
          if(text){
            range.deleteContents();
            range.insertNode(document.createTextNode(text.toUpperCase()));
          }
        }

        if(action==='clear'){
          const text=range.toString();
          range.deleteContents();
          range.insertNode(document.createTextNode(text));
        }

        window.getSelection()?.removeAllRanges();
        sync();
      });
    });

    // Preserve paragraph breaks explicitly.
    editor.addEventListener('keydown',e=>{
      if(e.key==='Enter' && !e.shiftKey){
        e.preventDefault();
        document.execCommand('insertParagraph',false);
        sync();
      }
      if(e.key==='Enter' && e.shiftKey){
        e.preventDefault();
        document.execCommand('insertLineBreak',false);
        sync();
      }
    });

    editor.addEventListener('input',sync);
    editor.addEventListener('blur',sync);
    editor.closest('form')?.addEventListener('submit',sync);
    sync();
  });
}
setupAdminCommentEditors();
</script>

</BaseLayout>
