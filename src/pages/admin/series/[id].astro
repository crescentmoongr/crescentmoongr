---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAdminSeriesById,getAdminChapters,hasAdminSeriesPassword,getChapterStats,chapterAdminStatus } from '../../../lib/supabase';
import { requireAdminSession } from '../../../lib/auth';
export const prerender=false;
const adminSession=await requireAdminSession(Astro.cookies);if(!adminSession)return Astro.redirect('/login?next=/admin');const token=adminSession.token;const id=Astro.params.id||'';const series=await getAdminSeriesById(id,token);if(!series)return new Response('Không tìm thấy truyện.',{status:404});const chapters=await getAdminChapters(id,token);const chapterStats=await getChapterStats(chapters.map(c=>c.id),token);const statMap=new Map(chapterStats.map(x=>[x.chapter_id,Number(x.view_count||0)]));const totalViews=chapterStats.reduce((n,x)=>n+Number(x.view_count||0),0);const hasPassword=series.access_type==='password'?await hasAdminSeriesPassword(id,token):false;const success=Astro.url.searchParams.get('success');const error=Astro.url.searchParams.get('error');
---
<BaseLayout title={`Quản lý — ${series.title}`}>
<section class="admin-card admin-wide"><div class="admin-top"><div><a class="meta" href="/admin">← Admin</a><h1>{series.title}</h1><p class="meta">{chapters.length} chapter · {totalViews.toLocaleString('vi-VN')} lượt đọc</p></div></div>{success&&<div class="notice success">{success}</div>}{error&&<div class="notice error">{error}</div>}
<div class="section-title"><h2>Sửa truyện</h2></div><form method="POST" action="/api/admin/series/update" enctype="multipart/form-data" class="admin-form"><input type="hidden" name="id" value={series.id}/><div class="form-grid"><label class="field"><span>Tên truyện *</span><input name="title" value={series.title} required maxlength="200"/></label><label class="field"><span>Slug *</span><input name="slug" value={series.slug} required maxlength="200"/></label><label class="field"><span>Tác giả</span><input name="author" value={series.author||''}/></label><label class="field"><span>Họa sĩ</span><input name="artist" value={series.artist||''}/></label><label class="field"><span>Thể loại</span><input name="genres" value={(series.genres||[]).join(', ')} placeholder="Romance, Comedy, Drama..."/></label><label class="field"><span>Loại truyện</span><select name="type"><option value="">— Chưa chọn —</option>{['Manga','Manhwa','Manhua','Novel','Other'].map(x=><option value={x} selected={series.type===x}>{x}</option>)}</select></label><label class="field"><span>Trạng thái</span><select name="status"><option value="ongoing" selected={series.status==='ongoing'}>Đang tiến hành</option><option value="completed" selected={series.status==='completed'}>Hoàn thành</option><option value="hiatus" selected={series.status==='hiatus'}>Tạm ngưng</option><option value="dropped" selected={series.status==='dropped'}>Drop</option></select></label><label class="field"><span>Quyền đọc *</span><select name="access_type" id="series_access_type"><option value="public" selected={series.access_type==='public'}>Public</option><option value="password" selected={series.access_type==='password'}>Khóa mật khẩu cả bộ</option><option value="member" selected={series.access_type==='member'}>Thành viên</option></select></label><label class="field" id="series_password_field" hidden><span>{hasPassword?'Đổi mật khẩu truyện':'Mật khẩu truyện *'}</span><input name="series_password" type="password" minlength="4" autocomplete="new-password" placeholder={hasPassword?'Để trống để giữ mật khẩu cũ':''}/></label></div><label class="field"><span>Mô tả</span><textarea name="description" rows="6">{series.description||''}</textarea></label><label class="field"><span>Thay ảnh bìa</span><input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif"/></label><label class="check-row"><input name="is_published" type="checkbox" value="true" checked={series.is_published}/><span>Đăng công khai</span></label><div class="row-actions"><button class="button" type="submit">Lưu thay đổi</button>{series.is_published&&<a class="button secondary" href={`/manga/${series.slug}`}>Xem trang truyện</a>}</div></form><hr class="soft-rule"/><form method="POST" action="/api/admin/series/delete" onsubmit="return confirm('Xóa truyện này và toàn bộ chapter/ảnh? Hành động này không thể hoàn tác.');"><input type="hidden" name="id" value={series.id}/><button class="danger-button" type="submit">Xóa truyện</button></form></section>

<section class="admin-card admin-wide"><div class="section-title"><h2>Thêm chapter</h2><span class="meta">Upload trước, publish ngay hoặc hẹn giờ</span></div><form method="POST" action="/api/admin/chapter/create" enctype="multipart/form-data" class="admin-form schedule-form"><input type="hidden" name="series_id" value={series.id}/><div class="form-grid"><label class="field"><span>Số chapter *</span><input name="chapter_number" type="number" step="0.01" min="0" required placeholder="1"/></label><label class="field"><span>Tiêu đề chapter</span><input name="title" maxlength="200"/></label><label class="field"><span>Trạng thái đăng</span><select name="publish_mode" class="publish-mode"><option value="publish">Publish ngay</option><option value="schedule">Lên lịch</option><option value="draft">Draft</option></select></label><label class="field schedule-field" hidden><span>Ngày giờ publish</span><input type="datetime-local" class="publish-local"/><input type="hidden" name="published_at" class="publish-iso"/><small class="meta">Dùng giờ trên máy của cậu.</small></label></div><label class="field"><span>Ảnh chapter *</span><input name="pages" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple required/><small class="meta">Sắp theo tên file: 001.webp, 002.webp...</small></label><button class="button" type="submit">Tạo chapter & Upload ảnh</button></form></section>

<section class="admin-card admin-wide"><div class="section-title"><div><h2>Chapters</h2><p class="meta">Kéo thả để đổi thứ tự hiển thị. Preview dùng được cả Draft và chapter đã lên lịch.</p></div><span class="meta">{chapters.length} chapter</span></div>
<form id="bulkForm" method="POST" action="/api/admin/chapter/bulk" class="bulk-bar"><input type="hidden" name="series_id" value={series.id}/><select name="bulk_action" required><option value="">Sửa hàng loạt...</option><option value="publish">Publish ngay</option><option value="draft">Chuyển Draft</option><option value="delete">Xóa</option></select><button class="button secondary small-button" type="submit" data-bulk-submit>Áp dụng</button><button class="button secondary small-button" type="button" id="saveOrder">Lưu thứ tự kéo thả</button><span class="meta" id="orderStatus"></span></form>
{chapters.length===0?<div class="empty-state">Chưa có chapter nào.</div>:<div class="chapter-admin-list sortable-list" id="chapterSortable">{chapters.map(ch=>{const st=chapterAdminStatus(ch);return <details class="chapter-admin-item sortable-item" data-chapter-id={ch.id} draggable="true"><summary><span class="drag-handle" title="Kéo để đổi thứ tự">☰</span><input class="bulk-check" type="checkbox" name="chapter_ids" value={ch.id} form="bulkForm" onclick="event.stopPropagation()"/><strong>Chapter {ch.chapter_number}</strong>{ch.title&&<span> — {ch.title}</span>}<span class={`status-chip ${st==='Draft'?'draft':st==='Đã lên lịch'?'scheduled':'published'}`}>{st}</span><span class="meta"> · {(statMap.get(ch.id)||0).toLocaleString('vi-VN')} lượt đọc</span></summary>
<form method="POST" action="/api/admin/chapter/update" class="chapter-edit-form schedule-form"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><div class="form-grid"><label class="field"><span>Số chap</span><input name="chapter_number" type="number" step="0.01" value={ch.chapter_number} required/></label><label class="field"><span>Tiêu đề</span><input name="title" value={ch.title||''}/></label><label class="field"><span>Trạng thái đăng</span><select name="publish_mode" class="publish-mode"><option value="publish" selected={st==='Published'}>Published</option><option value="schedule" selected={st==='Đã lên lịch'}>Lên lịch</option><option value="draft" selected={st==='Draft'}>Draft</option></select></label><label class="field schedule-field" hidden><span>Ngày giờ publish</span><input type="datetime-local" class="publish-local" data-iso={ch.published_at||''}/><input type="hidden" name="published_at" class="publish-iso" value={ch.published_at||''}/></label></div><div class="row-actions"><button class="button secondary" type="submit">Lưu chapter</button><a class="button secondary" href={`/admin/preview/${ch.id}`}>Preview</a>{st==='Published'&&<a class="button secondary" href={`/read/${series.slug}/${ch.chapter_number}`}>Xem public</a>}</div></form>
<div class="chapter-extra-actions"><form method="POST" action="/api/admin/chapter/duplicate" class="duplicate-form"><input type="hidden" name="source_id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><input name="target_number" type="number" step="0.01" required placeholder="Số chap copy"/><button class="button secondary small-button" type="submit">Duplicate</button></form><form method="POST" action="/api/admin/chapter/delete" onsubmit="return confirm('Xóa chapter này và toàn bộ ảnh?');"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><button class="danger-button small-danger" type="submit">Xóa chapter</button></form></div></details>})}</div>}
</section>
<script>
const a=document.querySelector('#series_access_type'),f=document.querySelector('#series_password_field');function toggleSeries(){if(a instanceof HTMLSelectElement&&f instanceof HTMLElement)f.hidden=a.value!=='password'}a?.addEventListener('change',toggleSeries);toggleSeries();
function localValue(iso){if(!iso)return'';const d=new Date(iso);if(!Number.isFinite(d.getTime()))return'';const z=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}T${z(d.getHours())}:${z(d.getMinutes())}`}
for(const form of document.querySelectorAll('.schedule-form')){if(!(form instanceof HTMLFormElement))continue;const mode=form.querySelector('.publish-mode'),field=form.querySelector('.schedule-field'),local=form.querySelector('.publish-local'),hidden=form.querySelector('.publish-iso');if(local instanceof HTMLInputElement&&local.dataset.iso)local.value=localValue(local.dataset.iso);const sync=()=>{if(mode instanceof HTMLSelectElement&&field instanceof HTMLElement)field.hidden=mode.value!=='schedule'};mode?.addEventListener('change',sync);sync();form.addEventListener('submit',e=>{if(mode instanceof HTMLSelectElement&&mode.value==='schedule'&&local instanceof HTMLInputElement&&hidden instanceof HTMLInputElement){if(!local.value){e.preventDefault();alert('Chọn ngày giờ publish.');return}hidden.value=new Date(local.value).toISOString()}})}
const list=document.querySelector('#chapterSortable');let dragging=null;if(list instanceof HTMLElement){for(const item of list.querySelectorAll('.sortable-item')){item.addEventListener('dragstart',()=>{dragging=item;item.classList.add('dragging')});item.addEventListener('dragend',()=>{item.classList.remove('dragging');dragging=null})}list.addEventListener('dragover',e=>{e.preventDefault();if(!(dragging instanceof HTMLElement))return;const after=[...list.querySelectorAll('.sortable-item:not(.dragging)')].find(el=>{const r=el.getBoundingClientRect();return e.clientY<r.top+r.height/2});if(after)list.insertBefore(dragging,after);else list.appendChild(dragging)})}
document.querySelector('#saveOrder')?.addEventListener('click',async()=>{if(!(list instanceof HTMLElement))return;const ids=[...list.querySelectorAll('.sortable-item')].map(x=>x.getAttribute('data-chapter-id')).filter(Boolean);const st=document.querySelector('#orderStatus');if(st)st.textContent='Đang lưu...';const sidInput=document.querySelector('#bulkForm input[name=series_id]');const sidValue=sidInput instanceof HTMLInputElement?sidInput.value:'';const r=await fetch('/api/admin/chapter/reorder',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({series_id:sidValue,ids})});if(st)st.textContent=r.ok?'Đã lưu thứ tự ✓':'Lưu thất bại';});
document.querySelector('[data-bulk-submit]')?.addEventListener('click',e=>{const select=document.querySelector('#bulkForm select');if(select instanceof HTMLSelectElement&&select.value==='delete'&&!confirm('Xóa tất cả chapter đã chọn và ảnh của chúng?'))e.preventDefault()});
</script></BaseLayout>
