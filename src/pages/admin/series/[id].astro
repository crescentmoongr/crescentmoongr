---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAdminSeriesById, getAdminChapters, hasAdminSeriesPassword } from '../../../lib/supabase';
import { requireAdminSession } from '../../../lib/auth';
export const prerender=false;
const adminSession=await requireAdminSession(Astro.cookies); if(!adminSession) return Astro.redirect('/login?next=/admin'); const token=adminSession.token; const admin=adminSession.user;
const id=Astro.params.id||''; const series=await getAdminSeriesById(id,token); if(!series) return new Response('Không tìm thấy truyện.',{status:404});
const chapters=await getAdminChapters(id,token); const hasPassword=series.access_type==='password' ? await hasAdminSeriesPassword(id,token) : false;
const success=Astro.url.searchParams.get('success'); const error=Astro.url.searchParams.get('error');
---
<BaseLayout title={`Quản lý — ${series.title}`}>
<section class="admin-card admin-wide">
  <div class="admin-top"><div><a class="meta" href="/admin">← Admin</a><h1>{series.title}</h1><p class="meta">Sửa thông tin truyện và quản lý chapter.</p></div></div>
  {success&&<div class="notice success">{success}</div>}{error&&<div class="notice error">{error}</div>}
  <div class="section-title"><h2>Sửa truyện</h2></div>
  <form method="POST" action="/api/admin/series/update" enctype="multipart/form-data" class="admin-form">
    <input type="hidden" name="id" value={series.id}/>
    <div class="form-grid">
      <label class="field"><span>Tên truyện *</span><input name="title" value={series.title} required maxlength="200"/></label>
      <label class="field"><span>Slug *</span><input name="slug" value={series.slug} required maxlength="200"/></label>
      <label class="field"><span>Tác giả</span><input name="author" value={series.author||''}/></label>
      <label class="field"><span>Họa sĩ</span><input name="artist" value={series.artist||''}/></label>
      <label class="field"><span>Thể loại</span><input name="genres" value={(series.genres||[]).join(', ')} placeholder="Romance, Comedy, Drama..."/><small class="meta">Ngăn cách bằng dấu phẩy.</small></label>
      <label class="field"><span>Loại truyện</span><input name="type" value={series.type||''} placeholder="Manga / Manhwa / Novel..."/></label>
      <label class="field"><span>Trạng thái</span><select name="status"><option value="ongoing" selected={series.status==='ongoing'}>Đang tiến hành</option><option value="completed" selected={series.status==='completed'}>Hoàn thành</option><option value="hiatus" selected={series.status==='hiatus'}>Tạm ngưng</option><option value="dropped" selected={series.status==='dropped'}>Drop</option></select></label>
      <label class="field"><span>Quyền đọc *</span><select name="access_type" id="series_access_type"><option value="public" selected={series.access_type==='public'}>Public</option><option value="password" selected={series.access_type==='password'}>Khóa mật khẩu cả bộ</option><option value="member" selected={series.access_type==='member'}>Thành viên</option></select></label>
      <label class="field" id="series_password_field" hidden><span>{hasPassword?'Đổi mật khẩu truyện':'Mật khẩu truyện *'}</span><input name="series_password" type="password" minlength="4" autocomplete="new-password" placeholder={hasPassword?'Để trống để giữ mật khẩu cũ':''}/><small class="meta">Mật khẩu này áp dụng cho toàn bộ chapter của truyện.</small></label>
    </div>
    <label class="field"><span>Mô tả</span><textarea name="description" rows="6">{series.description||''}</textarea></label>
    <label class="field"><span>Thay ảnh bìa</span><input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif"/><small class="meta">Để trống nếu giữ bìa hiện tại.</small></label>
    <label class="check-row"><input name="is_published" type="checkbox" value="true" checked={series.is_published}/><span>Đăng công khai</span></label>
    <div class="row-actions"><button class="button" type="submit">Lưu thay đổi</button>{series.is_published&&<a class="button secondary" href={`/manga/${series.slug}`}>Xem trang truyện</a>}</div>
  </form>
  <hr class="soft-rule"/>
  <form method="POST" action="/api/admin/series/delete" onsubmit="return confirm('Xóa truyện này và toàn bộ chapter/ảnh? Hành động này không thể hoàn tác.');"><input type="hidden" name="id" value={series.id}/><button class="danger-button" type="submit">Xóa truyện</button></form>
</section>

<section class="admin-card admin-wide">
  <div class="section-title"><h2>Thêm chapter</h2><span class="meta">Chapter tự kế thừa quyền đọc của cả bộ</span></div>
  <form method="POST" action="/api/admin/chapter/create" enctype="multipart/form-data" class="admin-form">
    <input type="hidden" name="series_id" value={series.id}/>
    <div class="form-grid"><label class="field"><span>Số chapter *</span><input name="chapter_number" type="number" step="0.01" min="0" required placeholder="1"/></label><label class="field"><span>Tiêu đề chapter</span><input name="title" maxlength="200"/></label></div>
    <label class="field"><span>Ảnh chapter *</span><input name="pages" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple required/><small class="meta">Ảnh sẽ được sắp theo tên file. Nên đặt 001.webp, 002.webp, 003.webp...</small></label>
    <label class="check-row"><input name="is_published" type="checkbox" value="true" checked/><span>Publish ngay</span></label>
    <button class="button" type="submit">Tạo chapter & Upload ảnh</button>
  </form>
</section>

<section class="admin-card admin-wide">
  <div class="section-title"><h2>Chapters</h2><span class="meta">{chapters.length} chapter</span></div>
  {chapters.length===0?<div class="empty-state">Chưa có chapter nào.</div>:<div class="chapter-admin-list">{chapters.map(ch=><details class="chapter-admin-item"><summary><strong>Chapter {ch.chapter_number}</strong>{ch.title&&<span> — {ch.title}</span>}<span class="meta"> · kế thừa quyền của truyện · {ch.is_published?'Published':'Draft'}</span></summary><form method="POST" action="/api/admin/chapter/update" class="chapter-edit-form"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><div class="form-grid"><label class="field"><span>Số chap</span><input name="chapter_number" type="number" step="0.01" value={ch.chapter_number} required/></label><label class="field"><span>Tiêu đề</span><input name="title" value={ch.title||''}/></label></div><label class="check-row"><input name="is_published" type="checkbox" value="true" checked={ch.is_published}/><span>Published</span></label><div class="row-actions"><button class="button secondary" type="submit">Lưu chapter</button>{ch.is_published&&<a class="button secondary" href={`/read/${series.slug}/${ch.chapter_number}`}>Xem</a>}</div></form><form method="POST" action="/api/admin/chapter/delete" onsubmit="return confirm('Xóa chapter này và toàn bộ ảnh?');"><input type="hidden" name="id" value={ch.id}/><input type="hidden" name="series_id" value={series.id}/><button class="danger-button small-danger" type="submit">Xóa chapter</button></form></details>)}</div>}
</section>
<script>
const a=document.querySelector('#series_access_type'); const f=document.querySelector('#series_password_field'); function toggle(){if(a instanceof HTMLSelectElement&&f instanceof HTMLElement)f.hidden=a.value!=='password'} a?.addEventListener('change',toggle); toggle();
</script>
</BaseLayout>
