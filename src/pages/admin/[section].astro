---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getAdminSeriesList, getAllAdminChapters, statusLabel, getSiteSetting, getAdminMembers, getAuthors, getGenres, getTags, getAdminSeriesComments, getServiceSiteSetting, getAllChapterStats, getCommentMemberRewards } from '../../lib/supabase';
import { requireAdminSession } from '../../lib/auth';
export const prerender=false;

const allowed=['announcement','social','ads','add-series','series','comments','members','authors','genres','tags'];
const section=String(Astro.params.section||'series');
if(!allowed.includes(section)) return Astro.redirect('/admin/series');
const adminSession=await requireAdminSession(Astro.cookies);
if(!adminSession)return Astro.redirect(`/login?next=${encodeURIComponent(`/admin/${section}`)}`);
const token=adminSession.token;const admin=adminSession.user;
const success=Astro.url.searchParams.get('success');const error=Astro.url.searchParams.get('error');


let rows:any[]=[]; const chapterCounts=new Map<string,number>(); const latestChapterAt=new Map<string,number>(); const seriesViews=new Map<string,number>();
const adminRankIconMap:any={mam_trang:'🌱',trang_non:'🌙',trang_tron:'🌕',anh_sao:'✨',sao_sang:'🌟',tinh_nguyet:'💫'}; let adminCommentRewardMap=new Map<string,any>();
let announcementHtml=''; let adHtml=''; let socialLinks:any={}; let members:any[]=[]; let membersError=''; let adminComments:any[]=[]; let commentsError=''; let authors:any[]=[]; let genresManaged:any[]=[]; let tagsManaged:any[]=[];

try{
  if(section==='series'){
    const [seriesRows,allChapters,allStats]=await Promise.all([getAdminSeriesList(token),getAllAdminChapters(token),getAllChapterStats(token)]);
    const chapterSeries=new Map(allChapters.map(ch=>[ch.id,ch.series_id]));
    for(const stat of allStats){const sid=chapterSeries.get(stat.chapter_id);if(sid)seriesViews.set(sid,(seriesViews.get(sid)||0)+(Number(stat.view_count)||0));}
    for(const ch of allChapters){
      chapterCounts.set(ch.series_id,(chapterCounts.get(ch.series_id)||0)+1);
      const published=ch.is_published && (!ch.published_at || new Date(ch.published_at).getTime()<=Date.now());
      if(published){
        const t=new Date(ch.published_at||ch.created_at).getTime();
        if(Number.isFinite(t)) latestChapterAt.set(ch.series_id,Math.max(latestChapterAt.get(ch.series_id)||0,t));
      }
    }
    rows=seriesRows.sort((a,b)=>{
      const aKey=latestChapterAt.get(a.id) || new Date(a.created_at).getTime() || 0;
      const bKey=latestChapterAt.get(b.id) || new Date(b.created_at).getTime() || 0;
      return bKey-aKey;
    });
  }
  if(section==='announcement') announcementHtml=(await getServiceSiteSetting('site_announcement_html'))?.value||'';
  if(section==='ads') adHtml=(await getSiteSetting('reader_ad_html',token))?.value||'';
  if(section==='social'){
    const raw=(await getSiteSetting('social_links',token))?.value||''; const parsed=raw?JSON.parse(raw):{}; if(parsed&&typeof parsed==='object')socialLinks=parsed;
  }
  if(section==='members'){try{members=await getAdminMembers(token)}catch(e){membersError=e instanceof Error?e.message:'Không tải được thành viên.'}}
  if(section==='comments'){try{adminComments=await getAdminSeriesComments(token); adminCommentRewardMap=new Map((await getCommentMemberRewards(adminComments.map((c:any)=>c.user_id).filter(Boolean))).map((x:any)=>[x.user_id,x]));}catch(e){commentsError=e instanceof Error?e.message:'Không tải được bình luận.'}}
  if(section==='authors') authors=await getAuthors();
  if(section==='genres') genresManaged=await getGenres();
  if(section==='tags') tagsManaged=await getTags(token);
  if(section==='add-series'){
    const [a,g,t]=await Promise.allSettled([getAuthors(),getGenres(),getTags(token)]);
    authors=a.status==='fulfilled'?a.value:[];
    genresManaged=g.status==='fulfilled'?g.value:[];
    tagsManaged=t.status==='fulfilled'?t.value:[];
  }
}catch{}
const pageTitles:any={announcement:'Thông báo chung',social:'Mạng xã hội',ads:'Quảng cáo','add-series':'Thêm truyện',series:'Quản lý truyện',comments:'Quản lý bình luận',members:'Quản lý thành viên',authors:'Quản lý tác giả',genres:'Quản lý thể loại',tags:'Quản lý Tag'};
---
<BaseLayout title={`${pageTitles[section]} — Admin — Crescent Moon Translation`}>
<section class="admin-card admin-wide"><div class="admin-top"><div><h1>Admin</h1><p class="meta">Đăng nhập: {admin.email}</p></div></div>
{success&&<div class="notice success top-gap">{success}</div>}{error&&<div class="notice error top-gap">{error}</div>}
</section>
<div class="admin-dashboard-layout wp-admin-layout">
  <AdminSidebar active={section}/>
  <div class="admin-dashboard-content">

{section==='announcement' && <section class="admin-card admin-wide admin-anchor-section">
  <div class="section-title"><div><h2>Thông báo chung</h2><p class="meta">Nội dung sẽ hiển thị ở đầu các trang ngoài website. Để trống rồi lưu nếu muốn ẩn thông báo.</p></div></div>
  <form method="POST" action="/api/admin/settings/announcement" class="admin-form">
    <div class="field rich-field"><span>Nội dung thông báo</span><div class="comment-editor-shell admin-comment-editor-shell" data-admin-rich-editor>
      <div class="comment-toolbar" role="toolbar" aria-label="Định dạng thông báo">
        <button type="button" data-admin-comment-cmd="bold"><strong>B</strong></button><button type="button" data-admin-comment-cmd="italic"><em>I</em></button><button type="button" data-admin-comment-cmd="underline"><u>U</u></button><button type="button" data-admin-comment-cmd="strikeThrough"><s>S</s></button><button type="button" data-admin-comment-action="upper">AA</button><button type="button" data-admin-comment-cmd="insertUnorderedList">• List</button><button type="button" data-admin-comment-cmd="insertOrderedList">1. List</button><button type="button" data-admin-comment-block="blockquote">❞</button><button type="button" data-admin-comment-block="code">&lt;/&gt;</button><button type="button" data-admin-comment-action="link">🔗</button><button type="button" data-admin-comment-action="clear">Tx</button>
      </div>
      <div class="comment-editor admin-comment-editor" contenteditable="true" data-placeholder="Nhập thông báo chung cho website..." spellcheck="true" set:html={announcementHtml}></div>
      <textarea class="comment-source admin-comment-source" name="announcement_html" maxlength="20000" hidden>{announcementHtml}</textarea>
    </div><small class="meta">Trình soạn thảo dùng cùng kiểu với phần Giới thiệu truyện.</small></div>
    <button class="button" type="submit">Lưu thông báo</button>
  </form>
</section>}

{section==='social' && <section class="admin-card admin-wide admin-anchor-section">
  <div class="section-title"><div><h2>Mạng xã hội</h2><p class="meta">Các link đã nhập sẽ hiển thị bằng icon ở chính giữa cuối website.</p></div></div>
  <form method="POST" action="/api/admin/settings/social" class="admin-form"><div class="form-grid">
    <label class="field"><span>Facebook</span><input name="facebook" type="url" maxlength="1000" value={socialLinks.facebook||''} placeholder="https://facebook.com/..."/></label>
    <label class="field"><span>Telegram</span><input name="telegram" type="url" maxlength="1000" value={socialLinks.telegram||''} placeholder="https://t.me/..."/></label>
    <label class="field"><span>Discord</span><input name="discord" type="url" maxlength="1000" value={socialLinks.discord||''} placeholder="https://discord.gg/..."/></label>
  </div><button class="button" type="submit">Lưu mạng xã hội</button></form>
</section>}

{section==='ads' && <section class="admin-card admin-wide admin-anchor-section">
  <div class="section-title"><h2>Quảng cáo</h2></div><form method="POST" action="/api/admin/settings/ads" class="admin-form"><label class="field"><span>HTML / Script quảng cáo</span><textarea name="ad_html" rows="12" maxlength="100000" placeholder="Dán nguyên code HTML / script của bên quảng cáo vào đây...">{adHtml}</textarea></label><p class="meta">Mã này được chạy trên toàn bộ website, trừ trang Admin.</p><button class="button" type="submit">Lưu quảng cáo</button></form>
</section>}

{section==='add-series' && <section class="admin-card admin-wide admin-anchor-section">
  <div class="section-title"><h2>Thêm truyện</h2></div>
  <form method="POST" action="/api/admin/series/create" enctype="multipart/form-data" class="admin-form"><div class="form-grid">
    <label class="field"><span>Tên truyện *</span><input id="title" name="title" required maxlength="200"/></label><label class="field"><span>Slug *</span><input id="slug" name="slug" required maxlength="200" placeholder="ten-truyen"/></label>
    <label class="field admin-series-full-row"><span>Tác giả</span><input name="author" maxlength="500" list="author-suggestions"/><datalist id="author-suggestions">{authors.map(a=><option value={a.name}/>)}</datalist></label>
    <div class="field genre-picker-field admin-series-full-row"><span>Thể loại</span><div class="genre-bubble-picker" data-genre-picker>{genresManaged.length===0?<span class="meta">Chưa tải được danh sách thể loại hoặc chưa có thể loại. Kiểm tra mục Quản lý thể loại.</span>:genresManaged.map(g=><label class="genre-bubble"><input type="checkbox" name="genres" value={g.name}/><span>{g.name}</span></label>)}</div></div>
    <div class="field genre-picker-field admin-series-full-row"><span>Tag</span><div class="genre-bubble-picker tag-bubble-picker">{tagsManaged.length===0?<span class="meta">Chưa có Tag hoặc chưa tải được danh sách. Kiểm tra mục Quản lý Tag.</span>:tagsManaged.map(t=><label class="genre-bubble"><input type="checkbox" name="tags" value={t.name}/><span>{t.name}</span></label>)}</div><small class="meta">Chọn các Tag phù hợp với truyện.</small></div>
    <label class="field"><span>Link mua raw</span><input name="raw_url" type="url" maxlength="1000" placeholder="https://..."/></label><label class="field"><span>Loại truyện</span><select name="type"><option value="">— Chưa chọn —</option><option value="Manga">Manga</option><option value="Manhwa">Manhwa</option><option value="Manhua">Manhua</option><option value="Novel">Novel</option><option value="Other">Khác</option></select></label>
    <label class="field"><span>Trạng thái *</span><select name="status" required><option value="ongoing">Đang tiến hành</option><option value="completed">Hoàn thành</option><option value="hiatus">Tạm ngưng</option><option value="dropped">Drop</option><option value="upcoming">Sắp ra mắt</option></select></label><label class="field"><span>Quyền đọc *</span><select name="access_type" id="new_access_type" required><option value="public">Public</option><option value="password">Khóa mật khẩu cả bộ</option><option value="member">Thành viên</option></select></label><label class="field" id="new_series_password_field" hidden><span>Mật khẩu truyện *</span><input name="series_password" type="password" minlength="4" autocomplete="new-password"/></label>
  </div>
  <div class="field rich-field"><span>Giới thiệu</span><div class="comment-editor-shell admin-comment-editor-shell" data-admin-rich-editor><div class="comment-toolbar"><button type="button" data-admin-comment-cmd="bold"><strong>B</strong></button><button type="button" data-admin-comment-cmd="italic"><em>I</em></button><button type="button" data-admin-comment-cmd="underline"><u>U</u></button><button type="button" data-admin-comment-cmd="strikeThrough"><s>S</s></button><button type="button" data-admin-comment-action="upper">AA</button><button type="button" data-admin-comment-cmd="insertUnorderedList">• List</button><button type="button" data-admin-comment-cmd="insertOrderedList">1. List</button><button type="button" data-admin-comment-block="blockquote">❞</button><button type="button" data-admin-comment-block="code">&lt;/&gt;</button><button type="button" data-admin-comment-action="clear">Tx</button></div><div class="comment-editor admin-comment-editor" contenteditable="true" data-placeholder="Nhập phần giới thiệu..." spellcheck="true"></div><textarea class="comment-source admin-comment-source" name="description" maxlength="20000" hidden></textarea></div></div>
  <label class="field"><span>Ảnh bìa *</span><input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required/></label><label class="check-row"><input name="is_published" type="checkbox" value="true" checked/><span>Đăng công khai ngay</span></label><button class="button" type="submit">Lưu truyện</button></form>
</section>}

{section==='series' && <section class="admin-card admin-wide admin-anchor-section">
  <div class="section-title"><div><h2>Quản lý truyện</h2><p class="meta">Truyện có chapter mới được publish sẽ lên đầu; các truyện còn lại xếp theo ngày tạo.</p></div><span class="meta" data-series-visible-count>{rows.length} truyện</span></div>
  {rows.length>0&&<form method="POST" action="/api/admin/series/bulk-password" class="admin-card series-bulk-password" data-bulk-password-form>
    <div><strong>🔐 Mật khẩu hàng loạt</strong><p class="meta">Chọn truyện bên dưới hoặc áp dụng cho toàn bộ truyện. Có thể gỡ pass rồi đặt lại một mật khẩu chung bất cứ lúc nào.</p></div>
    <div class="series-bulk-password-controls">
      <select name="scope" data-bulk-scope aria-label="Phạm vi"><option value="selected">Các truyện đã chọn</option><option value="all">Tất cả truyện</option></select>
      <select name="bulk_password_action" data-bulk-action aria-label="Thao tác"><option value="clear">Gỡ mật khẩu</option><option value="set">Đặt mật khẩu chung</option></select>
      <input name="bulk_password" type="password" minlength="4" placeholder="Nhập mật khẩu chung" data-bulk-password hidden/>
      <button class="button secondary small-button" type="submit">Áp dụng</button>
    </div>
    <div class="series-bulk-select"><label class="member-check"><input type="checkbox" data-select-all-series/><span>Chọn tất cả trong danh sách</span></label><span class="meta" data-selected-series-count>0 truyện đã chọn</span></div>
    <div data-selected-series-inputs></div>
  </form>}
  <label class="field admin-series-search"><span>Tìm truyện</span><input type="search" placeholder="Gõ tên truyện..." autocomplete="off" data-admin-series-search/></label>
  {rows.length===0?<div class="empty-state">Chưa có truyện nào.</div>:<div class="admin-series-list" data-admin-series-list>{rows.map(item=>{const chapterCount=chapterCounts.get(item.id)||0;return <div class="admin-series-row" data-series-row data-series-id={item.id} data-series-search-text={`${item.title} ${item.slug}`}>
    <label class="admin-series-select" title="Chọn truyện"><input type="checkbox" data-series-select value={item.id}/></label>
    <div class="admin-thumb">{item.cover_key?<img src={`/api/cover/${item.id}`} alt="" loading="lazy"/>:<span>Không bìa</span>}</div>
    <div class="admin-series-details">
      <div class="admin-series-title-line"><strong>{item.title}</strong><span class="meta">{chapterCount} chapter</span></div>
      <div class="meta admin-series-slug">/{item.slug}</div>
      <div class="meta admin-series-info"><span>{item.access_type==='password'?'🔒 Mật khẩu cả bộ':item.access_type==='member'?'🔒 Thành viên':'Public'}</span><span>{statusLabel(item.status)} · {item.is_published?'Công khai':'Bản nháp'}</span><span>👁 {new Intl.NumberFormat('vi-VN').format(seriesViews.get(item.id)||0)} lượt xem</span></div>
      <div class="row-actions"><a class="button secondary small-button" href={`/admin/series/${item.id}`}>Sửa truyện</a>{item.is_published&&<a class="button secondary small-button" href={`/manga/${item.slug}`}>Xem</a>}</div>
    </div>
  </div>})}</div>}
  <div class="empty-state" hidden data-admin-series-no-results>Không tìm thấy truyện phù hợp.</div>
</section>}

{section==='comments' && <section class="admin-card admin-wide admin-anchor-section"><div class="section-title"><div><h2>Quản lý bình luận</h2><p class="meta">Bình luận của thành viên hiển thị ngay sau khi đăng. Admin vẫn có thể xem và xóa nội dung khi cần.</p></div><span class="meta">{adminComments.length} bình luận</span></div>
{commentsError?<div class="notice error">{commentsError}</div>:adminComments.length===0?<div class="empty-state">Chưa có bình luận nào.</div>:<div class="admin-comment-list">{adminComments.map(comment=><article class="admin-comment-row"><div class="admin-comment-main"><div class="admin-comment-headline"><span class="comment-member-identity"><span class="member-rank-icon">{comment.role==='admin'?'👑':adminRankIconMap[adminCommentRewardMap.get(comment.user_id)?.rank_key]||''}</span><strong class={comment.role==='admin'?'admin-celestial-gold':''}>{comment.display_name||comment.username||'Thành viên'}</strong></span></div><div class="meta">{comment.series_title||'Truyện'} · {new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(comment.created_at))}</div><div class="admin-comment-preview" set:html={comment.body}></div></div><div class="admin-comment-actions">{comment.series_slug&&<a class="button secondary small-button" href={`/manga/${comment.series_slug}#comments`} target="_blank">Xem truyện</a>}<form method="POST" action="/api/admin/comment/moderate" onsubmit="return confirm('Xóa bình luận này?');"><input type="hidden" name="id" value={comment.id}/><input type="hidden" name="action" value="delete"/><button class="danger-button small-danger" type="submit">Xóa</button></form></div></article>)}</div>}
</section>}

{section==='members' && <section class="admin-card admin-wide admin-anchor-section"><div class="section-title"><div><h2>Quản lý thành viên</h2><p class="meta">Quản lý tài khoản, Hạng thành viên, Danh hiệu, streak và cấp lại mật khẩu.</p></div><span class="meta">{members.length} tài khoản</span></div><label class="admin-member-search"><span>🔎 Tìm thành viên</span><input type="search" placeholder="Tìm theo tên hoặc email..." data-member-search/></label>{membersError?<div class="notice error">{membersError}</div>:members.length===0?<div class="empty-state">Chưa có thành viên.</div>:<div class="admin-member-list">{members.map(member=><article class="admin-member-editor" data-member-card data-member-search-text={`${member.display_name||''} ${member.username||''} ${member.email||''}`.toLowerCase()}><form method="POST" action="/api/admin/member/update" class="admin-member-row admin-member-row-expanded"><input type="hidden" name="user_id" value={member.user_id}/><div class="admin-member-main"><div class="comment-member-identity"><span class="member-rank-icon">{member.role==='admin'?'👑':adminRankIconMap[member.rank_key]||''}</span><strong class={member.role==='admin'?'member-name admin-celestial-gold':'member-name'}>{member.display_name||member.username||member.email||'Thành viên'}</strong></div><span class="meta">{member.email||member.user_id}</span><span class="meta">Tham gia: {member.created_at?new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date(member.created_at)):'—'}</span></div><label class="member-control"><span>Username</span><input name="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9_.-]+" value={member.username||''} placeholder="Chưa đặt username"/><small class="meta">Admin có thể sửa · không được trùng username khác.</small></label><label class="member-control"><span>Vai trò</span><select name="role"><option value="member" selected={member.role==='member'}>Member</option><option value="admin" selected={member.role==='admin'}>Admin</option></select></label><label class="member-control"><span>Hạng thành viên</span><select name="rank_key">{[['none','Chưa xếp hạng'],['mam_trang','🌱 Mầm Trăng'],['trang_non','🌙 Trăng Non'],['trang_tron','🌕 Trăng Tròn'],['anh_sao','✨ Ánh Sao'],['sao_sang','🌟 Sao Sáng'],['tinh_nguyet','💫 Tinh Nguyệt']].map(([v,l])=><option value={v} selected={(member.rank_key||'none')===v}>{l}</option>)}</select></label><label class="member-control"><span>Streak hiện tại</span><input name="current_streak" type="number" min="0" value={member.current_streak||0}/></label><label class="member-control"><span>Streak cao nhất</span><input name="highest_streak" type="number" min="0" value={member.highest_streak||0}/></label><div class="member-title-admin"><span>Danh hiệu đã cấp</span>{['Mọt Truyện','Nghiện Truyện','Cú Đêm','Hóng Chap','Fan Cứng','Thánh Bình Luận'].map(x=><label class="member-check"><input type="checkbox" name="achievements" value={x} checked={(member.achievements||[]).includes(x)}/><span>{x}</span></label>)}</div><label class="member-control"><span>Danh hiệu đang dùng</span><select name="active_achievement"><option value="">Không hiển thị</option>{(member.achievements||[]).map(x=><option value={x} selected={member.active_achievement===x}>{x}</option>)}</select></label><label class="member-check"><input type="checkbox" name="is_active" value="true" checked={member.is_active}/><span>Hoạt động</span></label><label class="member-check"><input type="checkbox" name="can_comment" value="true" checked={member.can_comment}/><span>Được bình luận</span></label><button class="button secondary small-button" type="submit">Lưu thay đổi</button></form><form method="POST" action="/api/admin/member/reset-password" class="admin-member-password"><input type="hidden" name="user_id" value={member.user_id}/><label class="member-control"><span>Cấp lại mật khẩu</span><input name="password" type="password" minlength="8" autocomplete="new-password" placeholder="Mật khẩu mới (ít nhất 8 ký tự)" required/></label><button class="button secondary small-button" type="submit" onclick="return confirm('Cấp mật khẩu mới cho thành viên này?');">Cấp lại mật khẩu</button></form></article>)}</div>}</section>}

