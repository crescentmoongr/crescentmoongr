<script>
const bulkForm=document.querySelector('[data-bulk-password-form]');
if(bulkForm instanceof HTMLFormElement){
  const action=bulkForm.querySelector('[data-bulk-action]');
  const password=bulkForm.querySelector('[data-bulk-password]');
  const scope=bulkForm.querySelector('[data-bulk-scope]');
  const all=document.querySelector('[data-select-all-series]');
  const boxes=Array.from(document.querySelectorAll('[data-series-select]')).filter(x=>x instanceof HTMLInputElement);
  const count=bulkForm.querySelector('[data-selected-series-count]');
  const holder=bulkForm.querySelector('[data-selected-series-inputs]');
  const sync=()=>{
    const selected=boxes.filter(x=>x.checked);
    if(count) count.textContent=`${selected.length} truyện đã chọn`;
    if(holder) holder.innerHTML=selected.map(x=>`<input type="hidden" name="series_ids" value="${x.value.replace(/&/g,'&amp;').replace(/"/g,'&quot;')}">`).join('');
    if(all instanceof HTMLInputElement){all.checked=boxes.length>0&&selected.length===boxes.length;all.indeterminate=selected.length>0&&selected.length<boxes.length;}
  };
  const togglePassword=()=>{if(action instanceof HTMLSelectElement&&password instanceof HTMLInputElement){const set=action.value==='set';password.hidden=!set;password.required=set;}};
  action?.addEventListener('change',togglePassword); togglePassword();
  boxes.forEach(x=>x.addEventListener('change',sync));
  all?.addEventListener('change',()=>{if(all instanceof HTMLInputElement){boxes.forEach(x=>x.checked=all.checked);sync();}});
  sync();
  bulkForm.addEventListener('submit',(event)=>{
    const isAll=scope instanceof HTMLSelectElement&&scope.value==='all';
    const selected=boxes.filter(x=>x.checked).length;
    if(!isAll&&!selected){event.preventDefault();alert('Hãy chọn ít nhất một truyện.');return;}
    const setting=action instanceof HTMLSelectElement&&action.value==='set';
    const target=isAll?'tất cả truyện':`${selected} truyện đã chọn`;
    if(!confirm(setting?`Đặt cùng một mật khẩu cho ${target}?`:`Gỡ mật khẩu và chuyển ${target} sang Public?`)) event.preventDefault();
  });
}
</script>
<script>
const title=document.querySelector('#title'),slug=document.querySelector('#slug');let slugTouched=false;slug?.addEventListener('input',()=>slugTouched=true);title?.addEventListener('input',()=>{if(slugTouched||!(slug instanceof HTMLInputElement)||!(title instanceof HTMLInputElement))return;slug.value=title.value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')});const access=document.querySelector('#new_access_type'),passwordField=document.querySelector('#new_series_password_field');const toggle=()=>{if(access instanceof HTMLSelectElement&&passwordField instanceof HTMLElement)passwordField.hidden=access.value!=='password'};access?.addEventListener('change',toggle);toggle();

const search=document.querySelector('[data-admin-series-search]');const rowsEls=[...document.querySelectorAll('[data-series-row]')];const count=document.querySelector('[data-series-visible-count]');const noResults=document.querySelector('[data-admin-series-no-results]');
const normalizeSearch=(value)=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLocaleLowerCase('vi').trim();
if(search instanceof HTMLInputElement){search.addEventListener('input',()=>{const q=normalizeSearch(search.value);let visible=0;rowsEls.forEach(row=>{if(!(row instanceof HTMLElement))return;const haystack=normalizeSearch(row.dataset.seriesSearchText||'');const show=!q||haystack.includes(q);row.hidden=!show;if(show)visible++;});if(count)count.textContent=`${visible} truyện`;if(noResults instanceof HTMLElement)noResults.hidden=visible!==0;});}
</script>

<script>
function setupAdminCommentEditors(){document.querySelectorAll('[data-admin-rich-editor]').forEach(shell=>{if(!(shell instanceof HTMLElement)||shell.dataset.ready==='1')return;shell.dataset.ready='1';const editor=shell.querySelector('.admin-comment-editor'),source=shell.querySelector('.admin-comment-source');if(!(editor instanceof HTMLElement)||!(source instanceof HTMLTextAreaElement))return;const normalizeHtml=()=>{const clone=editor.cloneNode(true);if(!(clone instanceof HTMLElement))return editor.innerHTML.trim();clone.querySelectorAll('div').forEach(div=>{const p=document.createElement('p');while(div.firstChild)p.appendChild(div.firstChild);div.replaceWith(p)});return clone.innerHTML.trim()};const sync=()=>{source.value=normalizeHtml()};const getSelectedRange=()=>{const sel=window.getSelection();if(!sel||!sel.rangeCount||sel.isCollapsed)return null;const range=sel.getRangeAt(0);if(!editor.contains(range.commonAncestorContainer))return null;return range};const wrapSelection=(tag)=>{const range=getSelectedRange();if(!range)return;const node=document.createElement(tag);try{range.surroundContents(node)}catch{const frag=range.extractContents();node.appendChild(frag);range.insertNode(node)}window.getSelection()?.removeAllRanges();sync()};shell.querySelectorAll('[data-admin-comment-cmd]').forEach(btn=>{btn.addEventListener('mousedown',e=>e.preventDefault());btn.addEventListener('click',()=>{const cmd=btn.getAttribute('data-admin-comment-cmd')||'';if(cmd==='bold')return wrapSelection('strong');if(cmd==='italic')return wrapSelection('em');if(cmd==='underline')return wrapSelection('u');if(cmd==='strikeThrough')return wrapSelection('s');editor.focus();document.execCommand(cmd,false);sync()})});shell.querySelectorAll('[data-admin-comment-block]').forEach(btn=>{btn.addEventListener('mousedown',e=>e.preventDefault());btn.addEventListener('click',()=>{const block=btn.getAttribute('data-admin-comment-block')||'p';const range=getSelectedRange();if(!range)return;if(block==='code')wrapSelection('code');else{const node=document.createElement(block);try{range.surroundContents(node)}catch{const frag=range.extractContents();node.appendChild(frag);range.insertNode(node)}window.getSelection()?.removeAllRanges();sync()}})});shell.querySelectorAll('[data-admin-comment-action]').forEach(btn=>{btn.addEventListener('mousedown',e=>e.preventDefault());btn.addEventListener('click',()=>{const action=btn.getAttribute('data-admin-comment-action'),range=getSelectedRange();if(action==='link'){const raw=window.prompt('Dán link liên kết (https://...):','https://');if(raw===null)return;let url=raw.trim();if(!url)return;if(!/^https?:\/\//i.test(url))url='https://'+url.replace(/^\/+/, '');try{new URL(url)}catch{window.alert('Link không hợp lệ.');return}const a=document.createElement('a');a.href=url;a.target='_blank';a.rel='noopener noreferrer';if(range){const frag=range.extractContents();a.appendChild(frag);range.insertNode(a)}else{a.textContent=url;editor.appendChild(a)}window.getSelection()?.removeAllRanges();sync();return}if(!range)return;if(action==='upper'){const text=range.toString();range.deleteContents();range.insertNode(document.createTextNode(text.toUpperCase()))}if(action==='clear'){const text=range.toString();range.deleteContents();range.insertNode(document.createTextNode(text))}window.getSelection()?.removeAllRanges();sync()})});editor.addEventListener('input',sync);editor.addEventListener('blur',sync);const form=editor.closest('form');form?.addEventListener('submit',sync,{capture:true});form?.addEventListener('formdata',(event)=>{sync();if(event instanceof FormDataEvent&&source.name)event.formData.set(source.name,source.value)});sync()})}
setupAdminCommentEditors();
</script>
</BaseLayout>

