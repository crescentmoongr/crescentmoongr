---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdminSeriesList, getAdminChapters, getChapterStats, statusLabel, getSiteSetting, getAdminMembers, getAuthors, getGenres, getAdminSeriesComments } from '../../lib/supabase';
import { requireAdminSession } from '../../lib/auth';
export const prerender=false;
const adminSession=await requireAdminSession(Astro.cookies);if(!adminSession)return Astro.redirect('/login?next=/admin');const token=adminSession.token;const admin=adminSession.user;
let rows=[];let connected=false;const stats=new Map<string,{chapters:number,views:number}>();
try{rows=await getAdminSeriesList(token);connected=true;await Promise.all(rows.map(async item=>{const chapters=await getAdminChapters(item.id,token);const cs=await getChapterStats(chapters.map(c=>c.id),token);stats.set(item.id,{chapters:chapters.length,views:cs.reduce((n,x)=>n+Number(x.view_count||0),0)})}))}catch{}
const success=Astro.url.searchParams.get('success');const error=Astro.url.searchParams.get('error');
let adHtml='';
try{adHtml=(await getSiteSetting('reader_ad_html',token))?.value||''}catch{}
let socialLinks:{facebook?:string;telegram?:string;discord?:string}={};
try{
  const raw=(await getSiteSetting('social_links',token))?.value||'';
  const parsed=raw?JSON.parse(raw):{};
  if(parsed&&typeof parsed==='object')socialLinks=parsed;
}catch{}
let members:any[]=[];let membersError='';
try{members=await getAdminMembers(token)}catch(e){membersError=e instanceof Error?e.message:'Không tải được thành viên.'}
let adminComments:any[]=[];let commentsError='';
try{adminComments=await getAdminSeriesComments(token)}catch(e){commentsError=e instanceof Error?e.message:'Không tải được bình luận.'}
const pendingComments=adminComments.filter(c=>c.moderation_status==='pending');
let authors:any[]=[];let genresManaged:any[]=[];
try{[authors,genresManaged]=await Promise.all([getAuthors(),getGenres()])}catch{}
---
<BaseLayout title="Admin — Crescent Moon Translation">
<section class="admin-card admin-wide"><div class="admin-top"><div><h1>Admin</h1><p class="meta">Đăng nhập: {admin.email}</p></div><form method="POST" action="/api/auth/logout"><button class="button secondary" type="submit">Đăng xuất</button></form></div>
<div class={connected?'notice success':'notice error'}>{connected?`Supabase đã kết nối · ${rows.length} truyện hiện có`:'Chưa kết nối được Supabase'}</div>{success&&<div class="notice success top-gap">{success}</div>}{error&&<div class="notice error top-gap">{error}</div>}
</section>

<div class="admin-dashboard-layout wp-admin-layout">
  <aside class="admin-sidebar" data-admin-sidebar>
    <button class="admin-mobile-menu-toggle" type="button" aria-expanded="false" data-admin-menu-toggle>☰ Menu quản trị</button>
    <div class="admin-sidebar-title">Quản lý</div>
    <nav class="admin-section-menu" aria-label="Menu quản trị" data-admin-section-menu>
  <a href="#admin-social">🌐 Mạng xã hội</a>
  <a href="#admin-ads">📢 Quảng cáo</a>
  <a href="#admin-add-series">➕ Thêm truyện</a>
  <a href="#admin-manage-series">📚 Quản lý truyện</a>
  <a href="#admin-comments">💬 Bình luận</a>
  <a href="#admin-members">👥 Thành viên</a>
  <a href="#admin-authors">✍️ Tác giả</a>
  <a href="#admin-genres">🏷️ Thể loại</a>
</nav>
  </aside>
  <div class="admin-dashboard-content">



<section class="admin-card admin-wide admin-anchor-section" id="admin-social">
  <div class="section-title">
    <div><h2>Mạng xã hội</h2><p class="meta">Các link đã nhập sẽ hiển thị bằng icon ở chính giữa cuối website.</p></div>
  </div>
  <form method="POST" action="/api/admin/settings/social" class="admin-form">
    <div class="form-grid">
      <label class="field"><span>Facebook</span><input name="facebook" type="url" maxlength="1000" value={socialLinks.facebook||''} placeholder="https://facebook.com/..."/></label>
      <label class="field"><span>Telegram</span><input name="telegram" type="url" maxlength="1000" value={socialLinks.telegram||''} placeholder="https://t.me/..."/></label>
      <label class="field"><span>Discord</span><input name="discord" type="url" maxlength="1000" value={socialLinks.discord||''} placeholder="https://discord.gg/..."/></label>
    </div>
    <p class="meta">Để trống ứng dụng nào thì icon ứng dụng đó sẽ không hiển thị ngoài website.</p>
    <button class="button" type="submit">Lưu mạng xã hội</button>
  </form>
</section>

<section class="admin-ad-section admin-anchor-section" id="admin-ads">
  <div class="section-title"><h2>Quảng cáo</h2></div>
  <form method="POST" action="/api/admin/settings/ads" class="admin-form">
    <label class="field">
      <span>HTML / Script quảng cáo</span>
      <textarea name="ad_html" rows="9" maxlength="100000" placeholder="Dán nguyên code HTML / script của bên quảng cáo vào đây...">{adHtml}</textarea>
    </label>
    <p class="meta">Mã này được chạy trên toàn bộ website, trừ trang Admin. Để trống rồi lưu nếu muốn tắt quảng cáo.</p>
    <button class="button" type="submit">Lưu quảng cáo</button>
  </form>
</section>
<hr class="soft-rule"/>
<section class="admin-anchor-section" id="admin-add-series">
<div class="section-title"><h2>Thêm truyện</h2></div>
<form method="POST" action="/api/admin/series/create" enctype="multipart/form-data" class="admin-form"><div class="form-grid">
<label class="field"><span>Tên truyện *</span><input id="title" name="title" required maxlength="200"/></label><label class="field"><span>Slug *</span><input id="slug" name="slug" required maxlength="200" placeholder="ten-truyen"/></label><label class="field"><span>Tác giả</span><input name="author" maxlength="500" list="author-suggestions" placeholder="Ví dụ: Kasukabe Akira, Hanabusa Suuji"/><datalist id="author-suggestions">{authors.map(a=><option value={a.name}/>)}</datalist><small class="meta">Có nhiều tác giả thì ngăn cách bằng dấu phẩy. Mỗi tên sẽ tự tạo thành một tác giả riêng với slug riêng.</small></label><div class="field genre-picker-field">
  <span>Thể loại</span>
  <div class="genre-bubble-picker" data-genre-picker>
    {genresManaged.map(g=>
      <label class="genre-bubble">
        <input type="checkbox" name="genres" value={g.name}/>
        <span>{g.name}</span>
      </label>
    )}
  </div>
  <small class="meta">Bấm vào từng thể loại để chọn nhiều mục.</small>
</div><label class="field"><span>Link mua raw</span><input name="raw_url" type="url" maxlength="1000" placeholder="https://..."/><small class="meta">Link trang chính thức để người đọc mua raw và ủng hộ tác giả.</small></label><label class="field"><span>Loại truyện</span><select name="type"><option value="">— Chưa chọn —</option><option value="Manga">Manga</option><option value="Manhwa">Manhwa</option><option value="Manhua">Manhua</option><option value="Novel">Novel</option><option value="Other">Khác</option></select></label><label class="field"><span>Trạng thái *</span><select name="status" required><option value="ongoing">Đang tiến hành</option><option value="completed">Hoàn thành</option><option value="hiatus">Tạm ngưng</option><option value="dropped">Drop</option></select></label><label class="field"><span>Quyền đọc *</span><select name="access_type" id="new_access_type" required><option value="public">Public</option><option value="password">Khóa mật khẩu cả bộ</option><option value="member">Thành viên</option></select></label><label class="field" id="new_series_password_field" hidden><span>Mật khẩu truyện *</span><input name="series_password" type="password" minlength="4" autocomplete="new-password"/></label></div>

<label class="field rich-field">
  <span>Giới thiệu</span>
  <div class="wp-editor" data-wp-editor>
    <div class="wp-editor-tabs">
      <button type="button" class="wp-editor-tab is-active" data-wp-mode="visual">Trực quan</button>
      <button type="button" class="wp-editor-tab" data-wp-mode="text">Văn bản</button>
    </div>
    <div class="wp-editor-toolbar" role="toolbar" aria-label="Định dạng giới thiệu">
      <select class="wp-format-select" data-wp-block title="Định dạng">
        <option value="p">Đoạn văn</option>
        <option value="h2">Tiêu đề 2</option>
        <option value="h3">Tiêu đề 3</option>
        <option value="h4">Tiêu đề 4</option>
        <option value="blockquote">Trích dẫn</option>
        <option value="pre">Định dạng sẵn</option>
      </select>

      <button type="button" class="wp-icon-btn" data-wp-cmd="bold" title="In đậm"><strong>B</strong></button>
      <button type="button" class="wp-icon-btn wp-italic-btn" data-wp-cmd="italic" title="In nghiêng">I</button>
      <button type="button" class="wp-icon-btn" data-wp-cmd="strikethrough" title="Gạch ngang"><s>abc</s></button>

      <span class="wp-toolbar-sep"></span>

      <button type="button" class="wp-icon-btn" data-wp-cmd="insertUnorderedList" title="Danh sách chấm">•≡</button>
      <button type="button" class="wp-icon-btn" data-wp-cmd="insertOrderedList" title="Danh sách số">1≡</button>
      <button type="button" class="wp-icon-btn" data-wp-cmd="blockquote" data-wp-special="blockquote" title="Trích dẫn">❝</button>

      <span class="wp-toolbar-sep"></span>

      <button type="button" class="wp-icon-btn" data-wp-cmd="justifyLeft" title="Căn trái">≡</button>
      <button type="button" class="wp-icon-btn wp-align-center" data-wp-cmd="justifyCenter" title="Căn giữa">≡</button>
      <button type="button" class="wp-icon-btn wp-align-right" data-wp-cmd="justifyRight" title="Căn phải">≡</button>

      <span class="wp-toolbar-sep"></span>

      <button type="button" class="wp-icon-btn" data-wp-action="link" title="Chèn / sửa liên kết">🔗</button>
      <button type="button" class="wp-icon-btn" data-wp-action="unlink" title="Gỡ liên kết">⛓</button>
      <button type="button" class="wp-icon-btn" data-wp-action="rule" title="Đường ngang">—</button>

      <span class="wp-toolbar-sep"></span>

      <button type="button" class="wp-icon-btn" data-wp-action="underline" title="Gạch chân"><u>U</u></button>
      <button type="button" class="wp-icon-btn" data-wp-action="clear" title="Xóa định dạng">Tx</button>
      <button type="button" class="wp-icon-btn" data-wp-action="undo" title="Hoàn tác">↶</button>
      <button type="button" class="wp-icon-btn" data-wp-action="redo" title="Làm lại">↷</button>
    </div>
    <div class="wp-visual-editor" contenteditable="true" data-placeholder="Nhập phần giới thiệu..."></div>
    <textarea class="wp-text-editor" spellcheck="false" maxlength="20000" hidden></textarea>
    <textarea class="wp-editor-source" name="description" maxlength="20000" hidden></textarea>
  </div>
  <small class="meta">Trình soạn thảo kiểu WordPress: có chế độ Trực quan và Văn bản (HTML).</small>
</label>
<label class="field"><span>Ảnh bìa *</span><input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required/><small class="meta">JPG, PNG, WebP hoặc GIF. Tối đa 8 MB.</small></label><label class="check-row"><input name="is_published" type="checkbox" value="true" checked/><span>Đăng công khai ngay</span></label><button class="button" type="submit">Lưu truyện</button></form>
</section>
<section class="admin-card admin-wide admin-anchor-section" id="admin-manage-series"><div class="section-title"><h2>Quản lý truyện</h2><span class="meta">{rows.length} truyện</span></div>{rows.length===0?<div class="empty-state">Chưa có truyện nào.</div>:<div class="admin-series-list">{rows.map(item=>{const x=stats.get(item.id)||{chapters:0,views:0};return <div class="admin-series-row"><div class="admin-thumb">{item.cover_key?<img src={`/api/cover/${item.id}`} alt="" loading="lazy"/>:<span>Không bìa</span>}</div><div><strong>{item.title}</strong><div class="meta">/{item.slug} · {statusLabel(item.status)} · {item.access_type==='password'?'🔒 Mật khẩu cả bộ':item.access_type==='member'?'🔒 Thành viên':'Public'} · {item.is_published?'Công khai':'Bản nháp'}</div><div class="admin-statline"><span>{x.chapters} chapter</span><span>{x.views.toLocaleString('vi-VN')} lượt đọc</span></div></div><div class="row-actions"><a class="button secondary small-button" href={`/admin/series/${item.id}`}>Sửa / Chapters</a>{item.is_published&&<a class="button secondary small-button" href={`/manga/${item.slug}`}>Xem</a>}</div></div>})}</div>}</section>


<section class="admin-card admin-wide admin-anchor-section" id="admin-authors">
  <div class="section-title"><div><h2>Quản lý tác giả</h2><p class="meta">Mỗi tác giả có trang riêng và có thể gắn tài khoản X.</p></div><span class="meta">{authors.length} tác giả</span></div>
  <form method="POST" action="/api/admin/author/save" class="admin-form taxonomy-create-form">
    <div class="form-grid">
      <label class="field"><span>Tên tác giả *</span><input name="name" required maxlength="200" placeholder="Tên tác giả"/></label>
      <label class="field"><span>Link tài khoản X</span><input name="x_url" type="url" maxlength="1000" placeholder="https://x.com/..."/></label>
    </div>
    <button class="button" type="submit">Thêm tác giả</button>
  </form>
  {authors.length?<div class="taxonomy-admin-list">{authors.map(a=>
    <form method="POST" action="/api/admin/author/save" class="taxonomy-admin-row">
      <input type="hidden" name="id" value={a.id}/>
      <label><span>Tên</span><input name="name" value={a.name} required maxlength="200"/></label>
      <label><span>X</span><input name="x_url" type="url" value={a.x_url||''} maxlength="1000" placeholder="https://x.com/..."/></label>
      <a class="button secondary small-button" href={`/author/${a.slug}`}>Xem trang</a>
      <button class="button secondary small-button" type="submit">Lưu</button>
      <button class="danger-button small-danger" type="submit" formaction="/api/admin/author/delete" onclick="return confirm('Xóa tác giả này khỏi danh mục? Truyện hiện có vẫn giữ tên tác giả.');">Xóa</button>
    </form>)}</div>:<div class="empty-state">Chưa có tác giả.</div>}
</section>

<section class="admin-card admin-wide admin-anchor-section" id="admin-genres">
  <div class="section-title"><div><h2>Quản lý thể loại</h2><p class="meta">Mỗi thể loại có trang riêng liệt kê các truyện tương ứng.</p></div><span class="meta">{genresManaged.length} thể loại</span></div>
  <form method="POST" action="/api/admin/genre/save" class="admin-form taxonomy-create-form" data-batch-genre-form>
    <div class="form-grid">
      <label class="field">
        <span>Tên thể loại *</span>
        <input name="name" required maxlength="2000" placeholder="Romance, Comedy, Drama, Slice of Life"/>
        <small class="meta">Có thể nhập nhiều thể loại cùng lúc, ngăn cách từng mục bằng dấu phẩy.</small>
      </label>
    </div>
    <button class="button" type="submit">Thêm thể loại</button>
  </form>
  {genresManaged.length?<div class="taxonomy-admin-list">{genresManaged.map(g=>
    <form method="POST" action="/api/admin/genre/save" class="taxonomy-admin-row genre-admin-row">
      <input type="hidden" name="id" value={g.id}/>
      <label><span>Tên</span><input name="name" value={g.name} required maxlength="120"/></label>
      <a class="button secondary small-button" href={`/genre/${g.slug}`}>Xem trang</a>
      <button class="button secondary small-button" type="submit">Lưu</button>
      <button class="danger-button small-danger" type="submit" formaction="/api/admin/genre/delete" onclick="return confirm('Xóa thể loại này khỏi danh mục?');">Xóa</button>
    </form>)}</div>:<div class="empty-state">Chưa có thể loại.</div>}
</section>


<section class="admin-card admin-wide admin-anchor-section" id="admin-comments">
  <div class="section-title">
    <div>
      <h2>Quản lý bình luận</h2>
      <p class="meta">Bình luận mới phải được Admin duyệt trước khi hiển thị ngoài website.</p>
    </div>
    <span class="comment-pending-count">{pendingComments.length} chờ duyệt · {adminComments.length} tổng</span>
  </div>

  {commentsError
    ? <div class="notice error">{commentsError}</div>
    : adminComments.length===0
      ? <div class="empty-state">Chưa có bình luận nào.</div>
      : <div class="admin-comment-list">
          {adminComments.map(comment=>
            <article class={`admin-comment-row ${comment.moderation_status==='pending'?'is-pending':'is-approved'}`}>
              <div class="admin-comment-main">
                <div class="admin-comment-headline">
                  <strong class={comment.role==='admin'?'admin-name-glow':''}>{comment.display_name||comment.username||'Thành viên'}</strong>
                  <span class={`comment-status-badge ${comment.moderation_status}`}>
                    {comment.moderation_status==='pending'?'Chờ duyệt':'Đã duyệt'}
                  </span>
                </div>
                <div class="meta">
                  {comment.series_title||'Truyện'} · {new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(comment.created_at))}
                </div>
                <div class="admin-comment-preview" set:html={comment.body}></div>
              </div>
              <div class="admin-comment-actions">
                {comment.series_slug&&<a class="button secondary small-button" href={`/manga/${comment.series_slug}#comments`} target="_blank">Xem truyện</a>}
                {comment.moderation_status==='pending'&&
                  <form method="POST" action="/api/admin/comment/moderate">
                    <input type="hidden" name="id" value={comment.id}/>
                    <input type="hidden" name="action" value="approve"/>
                    <button class="button small-button" type="submit">Duyệt</button>
                  </form>}
                <form method="POST" action="/api/admin/comment/moderate" onsubmit="return confirm('Xóa bình luận này?');">
                  <input type="hidden" name="id" value={comment.id}/>
                  <input type="hidden" name="action" value="delete"/>
                  <button class="danger-button small-danger" type="submit">Xóa</button>
                </form>
              </div>
            </article>
          )}
        </div>}
</section>

<section class="admin-card admin-wide admin-anchor-section" id="admin-members">
  <div class="section-title">
    <div><h2>Quản lý thành viên</h2><p class="meta">Khóa tài khoản, bật/tắt quyền bình luận hoặc thay đổi vai trò.</p></div>
    <span class="meta">{members.length} tài khoản</span>
  </div>
  {membersError
    ? <div class="notice error">{membersError}</div>
    : members.length===0
      ? <div class="empty-state">Chưa có thành viên.</div>
      : <div class="admin-member-list">
          {members.map(member=>
            <form method="POST" action="/api/admin/member/update" class="admin-member-row">
              <input type="hidden" name="user_id" value={member.user_id}/>
              <div class="admin-member-main">
                <strong class={member.role==='admin'?'member-name admin-name-glow':'member-name'}>
                  {member.display_name||member.username||member.email||'Thành viên'}
                </strong>
                <span class="meta">{member.email||member.user_id}</span>
                <span class="meta">Tham gia: {member.created_at?new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date(member.created_at)):'—'}</span>
              </div>
              <label class="member-control"><span>Vai trò</span><select name="role"><option value="member" selected={member.role==='member'}>Member</option><option value="admin" selected={member.role==='admin'}>Admin</option></select></label>
              <label class="member-check"><input type="checkbox" name="is_active" value="true" checked={member.is_active}/><span>Hoạt động</span></label>
              <label class="member-check"><input type="checkbox" name="can_comment" value="true" checked={member.can_comment}/><span>Được bình luận</span></label>
              <button class="button secondary small-button" type="submit">Lưu</button>
            </form>
          )}
        </div>}
</section>

  </div>
</div>
<script>
const title=document.querySelector('#title'),slug=document.querySelector('#slug');let slugTouched=false;slug?.addEventListener('input',()=>slugTouched=true);title?.addEventListener('input',()=>{if(slugTouched||!(slug instanceof HTMLInputElement)||!(title instanceof HTMLInputElement))return;slug.value=title.value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')});const access=document.querySelector('#new_access_type'),passwordField=document.querySelector('#new_series_password_field');const toggle=()=>{if(access instanceof HTMLSelectElement&&passwordField instanceof HTMLElement)passwordField.hidden=access.value!=='password'};access?.addEventListener('change',toggle);toggle();
</script>
<script>
function setupRichEditors(){
  document.querySelectorAll('.rich-editor-shell').forEach(shell=>{
    if(!(shell instanceof HTMLElement) || shell.dataset.ready==='1') return;
    shell.dataset.ready='1';
    const editor=shell.querySelector('.rich-editor');
    const source=shell.querySelector('.rich-source');
    if(!(editor instanceof HTMLElement)||!(source instanceof HTMLTextAreaElement)) return;
    const sync=()=>{source.value=editor.innerHTML.trim()};
    let savedRange=null;
    const saveSelection=()=>{
      const sel=window.getSelection();
      if(!sel||sel.rangeCount===0)return;
      const range=sel.getRangeAt(0);
      if(editor.contains(range.commonAncestorContainer))savedRange=range.cloneRange();
    };
    const restoreSelection=()=>{
      editor.focus();
      if(!savedRange)return;
      const sel=window.getSelection();
      if(!sel)return;
      sel.removeAllRanges();
      sel.addRange(savedRange);
    };

    editor.addEventListener('mouseup',saveSelection);
    editor.addEventListener('keyup',saveSelection);
    editor.addEventListener('focus',saveSelection);
    shell.querySelectorAll('.rich-tool').forEach(btn=>{
      btn.addEventListener('mousedown',e=>{
        e.preventDefault();
        saveSelection();
      });
    });

    shell.querySelectorAll('[data-rich-cmd]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const cmd=btn.getAttribute('data-rich-cmd')||'';
      const sel=window.getSelection();
      const hadSelection=!!(sel && sel.rangeCount && !sel.isCollapsed);

      // Formatting buttons only affect selected text.
      // If there is no selection, do nothing so Bold/Italic/Underline
      // can never become a sticky typing state.
      if(!hadSelection && ['bold','italic','underline'].includes(cmd)){
        return;
      }

      document.execCommand(cmd,false);

      // After formatting selected text, collapse the caret to the end
      // and explicitly neutralize any sticky inline formatting state.
      if(sel && sel.rangeCount && !sel.isCollapsed && ['bold','italic','underline'].includes(cmd)){
        const r=sel.getRangeAt(0).cloneRange();
        r.collapse(false);
        sel.removeAllRanges();
        sel.addRange(r);

        try{
          if(cmd==='bold' && document.queryCommandState('bold')) document.execCommand('bold',false);
          if(cmd==='italic' && document.queryCommandState('italic')) document.execCommand('italic',false);
          if(cmd==='underline' && document.queryCommandState('underline')) document.execCommand('underline',false);
        }catch{}
      }

      savedRange=sel&&sel.rangeCount?sel.getRangeAt(0).cloneRange():null;
      sync();
    }));
    shell.querySelectorAll('[data-rich-block]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const block=btn.getAttribute('data-rich-block')||'p';
      document.execCommand('formatBlock',false,block);
      saveSelection();
      sync();
    }));
    shell.querySelectorAll('[data-rich-action]').forEach(btn=>btn.addEventListener('click',()=>{
      restoreSelection();
      const action=btn.getAttribute('data-rich-action');
      if(action==='break') document.execCommand('insertHTML',false,'<br>');
      if(action==='rule') document.execCommand('insertHTML',false,'<hr><p><br></p>');
      if(action==='clear') document.execCommand('removeFormat',false);
      saveSelection();
      sync();
    }));
    editor.addEventListener('paste',e=>{
      e.preventDefault();
      const text=e.clipboardData?.getData('text/plain')||'';
      const sel=window.getSelection();
      if(!sel||sel.rangeCount===0)return;

      const range=sel.getRangeAt(0);
      range.deleteContents();

      // Always paste into a neutral wrapper. This prevents pasted text
      // from inheriting <strong>/<b> from the current caret container.
      const wrapper=document.createElement('span');
      wrapper.className='rich-paste-plain';

      const lines=text.replace(/\r\n?/g,'\n').split('\n');
      lines.forEach((line,index)=>{
        if(index)wrapper.appendChild(document.createElement('br'));
        wrapper.appendChild(document.createTextNode(line));
      });

      range.insertNode(wrapper);

      const next=document.createRange();
      next.setStartAfter(wrapper);
      next.collapse(true);
      sel.removeAllRanges();
      sel.addRange(next);
      savedRange=next.cloneRange();
      sync();
    });
    editor.addEventListener('input',sync);
    editor.addEventListener('blur',sync);
    editor.closest('form')?.addEventListener('submit',sync);
    sync();
  });
}
setupRichEditors();
</script>

<script>
(() => {
  const sidebar=document.querySelector('[data-admin-sidebar]');
  const toggle=document.querySelector('[data-admin-menu-toggle]');
  const menu=document.querySelector('[data-admin-section-menu]');
  if(!(sidebar instanceof HTMLElement)||!(toggle instanceof HTMLButtonElement)||!(menu instanceof HTMLElement))return;

  const mobile=()=>window.matchMedia('(max-width:900px)').matches;
  const close=()=>{
    sidebar.classList.remove('mobile-menu-open');
    toggle.setAttribute('aria-expanded','false');
  };

  toggle.addEventListener('click',()=>{
    if(!mobile())return;
    const open=sidebar.classList.toggle('mobile-menu-open');
    toggle.setAttribute('aria-expanded',String(open));
  });

  menu.querySelectorAll('a').forEach(link=>{
    link.addEventListener('click',()=>{ if(mobile()) close(); });
  });

  window.addEventListener('resize',()=>{ if(!mobile()) close(); });
})();
</script>


<script>
function setupWpEditors(){
  document.querySelectorAll('[data-wp-editor]').forEach(shell=>{
    if(!(shell instanceof HTMLElement)||shell.dataset.ready==='1')return;
    shell.dataset.ready='1';
    const visual=shell.querySelector('.wp-visual-editor');
    const text=shell.querySelector('.wp-text-editor');
    const source=shell.querySelector('.wp-editor-source');
    if(!(visual instanceof HTMLElement)||!(text instanceof HTMLTextAreaElement)||!(source instanceof HTMLTextAreaElement))return;

    let mode='visual';
    let savedRange=null;

    const syncFromVisual=()=>{
      const html=visual.innerHTML.trim();
      source.value=html;
      text.value=html;
    };
    const syncFromText=()=>{
      source.value=text.value.trim();
    };
    const saveSelection=()=>{
      const sel=window.getSelection();
      if(!sel||!sel.rangeCount)return;
      const r=sel.getRangeAt(0);
      if(visual.contains(r.commonAncestorContainer))savedRange=r.cloneRange();
    };
    const restoreSelection=()=>{
      visual.focus();
      if(!savedRange)return;
      const sel=window.getSelection();
      if(!sel)return;
      sel.removeAllRanges();
      sel.addRange(savedRange);
    };

    visual.addEventListener('mouseup',saveSelection);
    visual.addEventListener('keyup',saveSelection);
    visual.addEventListener('input',syncFromVisual);
    visual.addEventListener('blur',syncFromVisual);
    text.addEventListener('input',syncFromText);

    shell.querySelectorAll('[data-wp-cmd],[data-wp-action]').forEach(btn=>{
      btn.addEventListener('mousedown',e=>{e.preventDefault();saveSelection()});
    });

    shell.querySelectorAll('[data-wp-cmd]').forEach(btn=>btn.addEventListener('click',()=>{
      if(mode!=='visual')return;
      restoreSelection();
      document.execCommand(btn.getAttribute('data-wp-cmd')||'',false);
      saveSelection();
      syncFromVisual();
    }));


    shell.querySelectorAll('[data-wp-special="blockquote"]').forEach(btn=>btn.addEventListener('click',()=>{
      if(mode!=='visual')return;
      restoreSelection();
      document.execCommand('formatBlock',false,'blockquote');
      saveSelection();
      syncFromVisual();
    }));

    const block=shell.querySelector('[data-wp-block]');
    if(block instanceof HTMLSelectElement){
      block.addEventListener('change',()=>{
        if(mode!=='visual')return;
        restoreSelection();
        document.execCommand('formatBlock',false,block.value||'p');
        saveSelection();
        syncFromVisual();
      });
    }

    shell.querySelectorAll('[data-wp-action]').forEach(btn=>btn.addEventListener('click',()=>{
      if(mode!=='visual')return;
      restoreSelection();
      const action=btn.getAttribute('data-wp-action');

      if(action==='rule') document.execCommand('insertHorizontalRule',false);
      if(action==='clear') document.execCommand('removeFormat',false);
      if(action==='underline') document.execCommand('underline',false);
      if(action==='unlink') document.execCommand('unlink',false);
      if(action==='undo') document.execCommand('undo',false);
      if(action==='redo') document.execCommand('redo',false);

      if(action==='link'){
        const sel=window.getSelection();
        if(!sel || !sel.rangeCount || sel.isCollapsed){
          alert('Hãy bôi đen đoạn chữ cần gắn liên kết trước.');
        }else{
          const href=prompt('Nhập URL liên kết:','https://');
          if(href){
            try{
              const url=new URL(href);
              if(url.protocol==='http:'||url.protocol==='https:'){
                document.execCommand('createLink',false,url.href);
              }else{
                alert('URL phải bắt đầu bằng http:// hoặc https://');
              }
            }catch{
              alert('URL không hợp lệ.');
            }
          }
        }
      }

      saveSelection();
      syncFromVisual();
    }));

    // WordPress-like paste behavior: preserve formatting from the clipboard.
    // If clipboard HTML is unavailable, insert normal text with line breaks.
    visual.addEventListener('paste',e=>{
      e.preventDefault();
      const html=e.clipboardData?.getData('text/html')||'';
      const plain=e.clipboardData?.getData('text/plain')||'';
      if(html)document.execCommand('insertHTML',false,html);
      else document.execCommand('insertText',false,plain);
      syncFromVisual();
    });

    shell.querySelectorAll('[data-wp-mode]').forEach(tab=>tab.addEventListener('click',()=>{
      const next=tab.getAttribute('data-wp-mode')==='text'?'text':'visual';
      if(next===mode)return;
      if(next==='text'){
        syncFromVisual();
        visual.hidden=true;
        text.hidden=false;
      }else{
        visual.innerHTML=text.value;
        source.value=text.value.trim();
        text.hidden=true;
        visual.hidden=false;
      }
      mode=next;
      shell.querySelectorAll('[data-wp-mode]').forEach(x=>x.classList.toggle('is-active',x.getAttribute('data-wp-mode')===mode));
      const toolbar=shell.querySelector('.wp-editor-toolbar');
      if(toolbar instanceof HTMLElement)toolbar.classList.toggle('is-disabled',mode==='text');
    }));

    const form=shell.closest('form');
    form?.addEventListener('submit',()=>{
      if(mode==='visual')syncFromVisual(); else syncFromText();
    });
    syncFromVisual();
  });
}
setupWpEditors();
</script>

</BaseLayout>
