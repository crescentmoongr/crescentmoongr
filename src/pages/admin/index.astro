---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesList } from '../../lib/supabase';
export const prerender = false;
let count = 0;
let connected = false;
try { const rows = await getSeriesList(); count = rows.length; connected = true; } catch {}
---
<BaseLayout title="Admin — Crescent Reader">
<section class="admin-card">
  <h1>Admin</h1>
  <div class={connected ? 'notice success' : 'notice error'}>{connected ? `Supabase đã kết nối · ${count} truyện hiện có` : 'Chưa kết nối được Supabase'}</div>
  <p class="description">Đây vẫn là giao diện chuẩn bị. Bước sau sẽ thêm đăng nhập admin và form Thêm truyện → Thêm chapter → Upload ảnh lên R2.</p>
  <button class="button" disabled>Thêm truyện (bước sau)</button>
</section>
</BaseLayout>
